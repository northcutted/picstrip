{
  "name": "picstrip-release",
  "version": "1.0.0",
  "private": true,
  "description": "Semantic release config for PicStrip",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "12.0.0",
    "@semantic-release/release-notes-generator": "13.0.0",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "semver": "7.7.4",
    "yaml": "2.8.2"
  },
  "scripts": {
    "test:ci": "node --test scripts/ci/tests/*.test.mjs && python3 -m unittest discover -s scripts/ci/tests -p \"test_*.py\" && bundle exec ruby scripts/ci/tests/release_guard_test.rb",
    "check:workflows": "node scripts/ci/workflow_policy.mjs"
  }
}
