# Snapfile — configuration for `fastlane snapshot` / `capture_ios_screenshots`
# https://docs.fastlane.tools/actions/snapshot/

# Target devices.
# App Store Connect required size classes for iPhone + iPad submissions:
#   6.9"  → iPhone 17 Pro Max  (required)
#   6.7"  → iPhone Air         (required; 6.7" Super Retina class in Xcode 26)
#  13.0"  → iPad Pro 13-inch (M4) (required for iPad support)
devices([
  "iPhone 17 Pro Max",
  "iPhone Air",
  "iPad Pro 13-inch (M4)",
])

# Languages / locales to capture.
languages([
  "en-US",
])

# The UI test scheme that contains snapshot() calls.
scheme("PicStrip")

app_identifier("com.northcutt.PicStrip")

# Where captured PNGs are written. Relative to the repo root.
output_directory("./fastlane/screenshots")

# Wipe previous screenshots before each run so stale images never ship.
clear_previous_screenshots(true)

# Simulators are pre-booted by a CI step before fastlane runs.
# erase_simulator is intentionally omitted — it boots from scratch and hangs
# in headless CI. reinstall_app(true) gives equivalent cleanliness.
reinstall_app(true)

# Override status-bar to a clean, consistent look (9:41 AM, full signal/battery).
override_status_bar(true)

# Don't try to open a browser/HTML summary in headless CI.
skip_open_summary(true)

# Run one simulator at a time to avoid resource contention on CI runners.
concurrent_simulators(false)

# Stop on the first test failure rather than collecting broken screenshots.
stop_after_first_error(true)
