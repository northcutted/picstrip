{
  "sourceLanguage" : "en",
  "strings" : {
    "01_VideoEditor" : {
      "comment" : "App Store screenshot 1 headline, over the video editor: two people in a street video, one face blurred and one covered with an emoji, and a bleep on the sound. Two short lines; the second says the covers track the faces as they move.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موّه الوجوه في الفيديو\nتبقى محجوبة أثناء الحركة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichter verpixeln\nIm Video, auch in Bewegung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur faces in videos\nFollowed as they move"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pixela caras en vídeos\nLas sigue al moverse"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difumina caras en videos\nLas sigue al moverse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visages floutés en vidéo\nSuivis quand ils bougent"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoca i volti nei video\nSeguiti in movimento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画の顔をぼかす\n動きに合わせて自動で追従"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 속 얼굴 모자이크\n움직여도 따라가며 가립니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaag gezichten in video’s\nVolgt elke beweging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamaż twarze na wideo\nPodąża za nimi w ruchu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borre rostos em vídeos\nAcompanha cada movimento"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque caras em vídeos\nSegue cada movimento"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blurra ansikten i videor\nFöljer varje rörelse"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoda yüz bulanıklaştırma\nHer hareketi takip eder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频人脸打码\n随人移动，持续跟踪"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片人臉打馬賽克\n隨人移動，持續追蹤"
          }
        }
      }
    },
    "02_Location" : {
      "comment" : "App Store screenshot 2 headline, over a photo's location details (latitude and longitude) and its Camera & date chip. Two short lines; the second lists what a photo silently carries: GPS position, the device it was taken on, and the date.",
