{
  "sourceLanguage" : "en",
  "strings" : {
    "01_VideoEditor" : {
      "comment" : "App Store screenshot 1 headline, over the video editor: two people in a street video, one face blurred and one covered with an emoji, and a bleep on the sound. Two short lines; the second says the covers track the faces as they move.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur faces in videos\nFollowed as they move"
          }
        }
      }
    },
    "02_Location" : {
      "comment" : "App Store screenshot 2 headline, over a photo's location details (latitude and longitude) and its Camera & date chip. Two short lines; the second lists what a photo silently carries: GPS position, the device it was taken on, and the date.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove hidden location\nGPS, device and date"
          }
        }
      }
    },
    "03_Viewfinder" : {
      "comment" : "App Store screenshot 3 headline, over the camera's live viewfinder, which outlines a face, an email address and a QR code before the photo is taken. Two short lines.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See it before you shoot\nLive preview of what’s covered"
          }
        }
      }
    },
    "04_Redaction" : {
      "comment" : "App Store screenshot 4 headline, over the photo editor: faces blurred or covered with an emoji, a phone number and a QR code pixelated, a bank card number blacked out. Line 1: the cover styles; line 2: what can be covered. Use the app's own words for Blur, Pixelate and Emoji.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blur, pixelate or emoji\nFaces, text, cards and codes"
          }
        }
      }
    },
    "05_ReviewAndShare" : {
      "comment" : "App Store screenshot 5 headline, over the Review & Share sheet with every check passed. Two short lines; the second is two short sentences: the app needs no account and does no tracking.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check, then share\nNo account. No tracking."
          }
        }
      }
    },
    "06_Batch" : {
      "comment" : "App Store screenshot 6 headline, over the batch sheet with photos and videos picked together. Two short lines.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean many at once\nPhotos and videos together"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
