      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف الموقع المخفي\nبيانات GPS والجهاز والتاريخ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortdaten entfernen\nGPS, Gerät und Datum"
          }
        },
