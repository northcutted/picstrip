    "01_Home" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك الصورة.\nلا القصة وراءها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
