{
  "sourceLanguage": "en",
  "strings": {
    "01_Home": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك الصورة.\nلا القصة وراءها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile das Foto.\nNicht die Geschichte dahinter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the photo.\nNot the story behind it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la foto.\nNo la historia detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez la photo.\nPas l'histoire derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi la foto.\nNon la storia dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は共有。\n背景の情報は守る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 공유하세요.\n그 안의 정보는 빼고."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel de foto.\nNiet het verhaal erachter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij zdjęcie.\nNie historię za nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe a foto.\nNão a história por trás."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhe a foto.\nNão a história por detrás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela bilden.\nInte historien bakom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı paylaş.\nArkasındaki hikâyeyi değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享照片。\n不分享背后的故事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享照片。\n不分享背後的故事。"
          }
        }
      }
    },
    "02_About": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتوح المصدر.\nخصوصية يمكن تدقيقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source.\nPrüfbare Privatsphäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nAuditable privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código abierto.\nPrivacidad auditable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nConfidentialité auditable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nPrivacy verificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンソース。\n検証可能なプライバシー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오픈 소스.\n검증 가능한 프라이버시."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nControleerbare privacy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarty kod.\nAudytowalna prywatność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto.\nPrivacidade auditável."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto.\nPrivacidade auditável."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppen källkod.\nGranskbar integritet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kaynak.\nDenetlenebilir gizlilik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源代码。\n隐私可审计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開源程式碼。\n隱私可稽核。"
          }
        }
      }
    },
    "03_PhotoLoaded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات حساسة\nتُكتشف فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Daten\nsofort erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive data\ncaught instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos sensibles\ndetectados al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données sensibles\ndétectées instantanément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati sensibili\nrilevati all'istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密データを\n即座に検出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 데이터\n즉시 감지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevoelige data\ndirect herkend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrażliwe dane\nwykryte natychmiast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados sensíveis\ndetectados na hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados sensíveis\ndetetados de imediato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Känslig data\nupptäcks direkt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas veri\nanında yakalanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感信息\n即时识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感資訊\n即時識別。"
          }
        }
      }
    },
    "04_RedactionEditor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم لإخفاء\nأي شيء حساس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne über alles,\nwas privat bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw to hide\nanything sensitive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta para ocultar\nlo sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez pour masquer\nce qui est sensible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna per nascondere\ndati sensibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぞって隠す\n気になる部分を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 부분은\n그려서 가리기."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken om alles\ngevoeligs te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz, by ukryć\nco wrażliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe para ocultar\no que for sensível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe para esconder\no que for sensível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita för att dölja\nkänsligt innehåll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas her şeyi\nçizerek gizle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随手涂抹\n隐藏敏感信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨手塗抹\n隱藏敏感資訊。"
          }
        }
      }
    },
    "05_ReviewAndSave": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدِّر بأمان.\nشارك بثقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauber exportieren.\nSicher teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export clean.\nShare confidently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta limpio.\nComparte tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez sans traces.\nPartagez sereinement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta pulito.\nCondividi sereno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きれいに書き出し。\n安心して共有。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗하게 내보내기.\n안심하고 공유."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer schoon.\nDeel zorgeloos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj czysto.\nUdostępniaj spokojnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte limpo.\nCompartilhe tranquilo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte limpo.\nPartilhe tranquilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera rent.\nDela tryggt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz dışa aktar.\nGönül rahatlığıyla paylaş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "干净导出。\n放心分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "乾淨匯出。\n放心分享。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
