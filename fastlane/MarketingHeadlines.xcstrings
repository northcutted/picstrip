    "03_Viewfinder" : {
      "comment" : "App Store screenshot 3 headline, over the camera's live viewfinder, which outlines a face, an email address and a QR code before the photo is taken. Two short lines.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد قبل أن تصوّر\nمعاينة مباشرة لما سيُحجب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh es vor dem Auslösen\nAbdeckung live im Sucher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See it before you shoot\nLive preview of what’s covered"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Míralo antes de disparar\nVe en directo qué se tapa"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Míralo antes de disparar\nVe en vivo qué se tapa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez avant de déclencher\nAperçu en direct du masquage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda prima di scattare\nCoperture in tempo reale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮る前に確認できる\n隠す部分をリアルタイム表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찍기 전에 먼저 확인\n가릴 부분 실시간 미리보기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie het vóór je klikt\nAfdekking live in beeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz, zanim pstrykniesz\nPodgląd zamazania na żywo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja antes de fotografar\nPrévia ao vivo da ocultação"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja antes de fotografar\nPré-visualize o que oculta"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se det innan du tar bilden\nMaskeringen syns live"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çekmeden önce görün\nGizlenecekler canlı görünür"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄前先预览\n实时预览要遮盖的内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝前先預覽\n即時預覽要遮蓋的內容"
          }
        }
      }
    },
    "04_Redaction" : {
      "comment" : "App Store screenshot 4 headline, over the photo editor: faces blurred or covered with an emoji, a phone number and a QR code pixelated, a bank card number blacked out. Line 1: the cover styles; line 2: what can be covered. Use the app's own words for Blur, Pixelate and Emoji.",
