{
  "sourceLanguage": "en",
  "strings": {
    "01_Home": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك الصورة.\nلا القصة وراءها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile das Foto.\nNicht die Geschichte dahinter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the photo.\nNot the story behind it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la foto.\nNo la historia detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez la photo.\nPas l'histoire derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi la foto.\nNon la storia dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は共有。\n背景の情報は守る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 공유하세요.\n그 안의 정보는 빼고."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel de foto.\nNiet het verhaal erachter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij zdjęcie.\nNie historię za nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe a foto.\nNão a história por trás."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhe a foto.\nNão a história por detrás."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela bilden.\nInte historien bakom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı paylaş.\nArkasındaki hikâyeyi değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享照片。\n不分享背后的故事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享照片。\n不分享背後的故事。"
          }
        }
      }
    },
    "02_About": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتوح المصدر.\nخصوصية يمكن تدقيقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source.\nPrüfbare Privatsphäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nAuditable privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código abierto.\nPrivacidad auditable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nConfidentialité auditable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nPrivacy verificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンソース。\n検証可能なプライバシー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오픈 소스.\n검증 가능한 프라이버시."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source.\nControleerbare privacy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarty kod.\nAudytowalna prywatność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto.\nPrivacidade auditável."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto.\nPrivacidade auditável."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppen källkod.\nGranskbar integritet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kaynak.\nDenetlenebilir gizlilik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源代码。\n隐私可审计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開源程式碼。\n隱私可稽核。"
          }
        }
      }
    },
    "03_PhotoLoaded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصنّفة حسب الخطورة.\nلا شيء يفوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiken eingestuft.\nNichts übersehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risks ranked.\nNothing missed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesgos ordenados.\nNada se escapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Risques classés.\nRien de manqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rischi classificati.\nNulla sfugge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスク評価済み。\n見逃しゼロ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험 등급 분류.\n놓치는 것 없이."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Risico's gerangschikt.\nNiets gemist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryzyka ocenione.\nNic nie umknie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscos classificados.\nNada passa despercebido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscos classificados.\nNada passa despercebido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Risker rangordnade.\nIngenting missas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riskler sıralandı.\nHiçbir şey gözden kaçmıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风险已评级。\n无一遗漏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風險已評級。\n無一遺漏。"
          }
        }
      }
    },
    "04_RedactionEditor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد متعدد.\nبالطريقة التي تريدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrfachauswahl.\nNach deinen Regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-select.\nRedact your way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección múltiple.\nA tu manera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection multiple.\nÀ votre façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezione multipla.\nA modo tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数選択。\n自分流に編集。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다중 선택.\n나만의 방식으로."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerdere selecteren.\nOp jouw manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz wiele.\nRedaguj po swojemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleção múltipla.\nDo seu jeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleção múltipla.\nÀ sua maneira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj flera.\nRedigera som du vill."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu seçim.\nKendi yönteminle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多选模式。\n按你的方式涂抹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多選模式。\n照你的方式遮蓋。"
          }
        }
      }
    },
    "05_ReviewAndSave": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدِّر بأمان.\nشارك بثقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauber exportieren.\nSicher teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export clean.\nShare confidently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta limpio.\nComparte tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez sans traces.\nPartagez sereinement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta pulito.\nCondividi sereno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きれいに書き出し。\n安心して共有。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗하게 내보내기.\n안심하고 공유."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer schoon.\nDeel zorgeloos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj czysto.\nUdostępniaj spokojnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte limpo.\nCompartilhe tranquilo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte limpo.\nPartilhe tranquilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera rent.\nDela tryggt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz dışa aktar.\nGönül rahatlığıyla paylaş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "干净导出。\n放心分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "乾淨匯出。\n放心分享。"
          }
        }
      }
    }
  },
