    "05_ReviewAndShare" : {
      "comment" : "App Store screenshot 5 headline, over the Review & Share sheet with every check passed. Two short lines; the second is two short sentences: the app needs no account and does no tracking.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع ثم شارك\nبلا حساب. بلا تتبع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst prüfen, dann teilen\nKein Account. Kein Tracking."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check, then share\nNo account. No tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa y luego comparte\nSin cuenta. Sin rastreo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa y luego comparte\nSin cuenta. Sin rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez, puis partagez\nSans compte. Sans pistage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla, poi condividi\nSenza account né tracciamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認してから共有\n登録不要。トラッキングなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인하고 공유하세요\n계정 없음. 추적 없음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerst checken, dan delen\nGeen account. Geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, potem udostępnij\nBez konta. Bez śledzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise e compartilhe\nSem conta. Sem rastreamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja e partilhe\nSem conta. Sem rastreio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska först, dela sen\nInget konto. Ingen spårning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleyin, sonra paylaşın\nHesap yok. İzleme yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先检查，再分享\n无需账户，无追踪"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先檢查，再分享\n免帳號，不追蹤"
          }
        }
      }
    },
