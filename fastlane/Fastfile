default_platform(:ios)

platform :ios do
  # ── Constants ────────────────────────────────────────────────────────────────
  ROOT          = File.expand_path("..", __dir__)
  APP_ID         = "com.northcutt.PicStrip"
  EXTENSION_ID   = "com.northcutt.PicStrip.ShareExtension"
  SCHEME         = "PicStrip"
  PROJECT        = "PicStrip.xcodeproj"
  OUTPUT_DIR     = "build"
  IPA_NAME       = "PicStrip.ipa"
  # App Store Connect category IDs. Display names like "Photo & Video" are not
  # valid relationship IDs when Fastlane patches app info categories.
  APP_STORE_PRIMARY_CATEGORY = "PHOTO_AND_VIDEO"
  APP_STORE_SECONDARY_CATEGORY = "UTILITIES"
  SCREENSHOT_DEVICES = [
    "iPhone 17 Pro Max",
    "iPad Pro 13-inch (M5)"
  ]
  EXPORT_COMPLIANCE_PLISTS = [
    "PicStrip-Info.plist",
    "PicStripShareExtension/Info.plist"
  ].freeze
  EXPORT_COMPLIANCE_SUBMISSION = {
    # PicStrip uses only standard platform encryption, so it does not use
    # non-exempt encryption. Keep this in sync with ITSAppUsesNonExemptEncryption=false.
    export_compliance_uses_encryption: false
  }.freeze

  private_lane :validate_export_compliance do
    require "plist"

    invalid = EXPORT_COMPLIANCE_PLISTS.filter_map do |relative_path|
      path = File.join(ROOT, relative_path)
      plist = Plist.parse_xml(path)
      relative_path unless plist && plist["ITSAppUsesNonExemptEncryption"] == false
    end

    UI.user_error!(
      "Expected ITSAppUsesNonExemptEncryption=false in: #{invalid.join(', ')}"
    ) if invalid.any?
  end

  private_lane :validate_release_notes do
    metadata_root = File.join(ROOT, "fastlane", "metadata")
    locale_dirs = Dir.children(metadata_root)
                     .map { |entry| File.join(metadata_root, entry) }
                     .select { |path| File.directory?(path) }
                     .reject { |path| File.basename(path) == "review_information" }
                     .sort

    missing = locale_dirs.filter_map do |path|
      notes_path = File.join(path, "release_notes.txt")
      File.basename(path) unless File.exist?(notes_path) && !File.read(notes_path).strip.empty?
    end

    UI.user_error!(
      "Missing App Store release_notes.txt for locale(s): #{missing.join(', ')}. " \
      "Render release metadata before app_store_stage."
    ) if missing.any?
  end

  private_lane :infer_metadata_target do |options|
    client = Spaceship::ConnectAPI
    app = Spaceship::ConnectAPI::App.find(APP_ID, client: client)

    UI.user_error!("Could not find App Store Connect app for bundle id #{APP_ID}") if app.nil?

    version = app.get_edit_app_store_version(
      client: client,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES
    )

    version ||= app.get_pending_release_app_store_version(
      client: client,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES
    )

    version ||= app.get_in_review_app_store_version(
      client: client,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES
    )

    UI.user_error!(
      "Could not infer an editable App Store version. Pass MARKETING_VERSION and BUILD_NUMBER explicitly."
    ) if version.nil?

    build = begin
      version.get_build(client: client)
    rescue
      nil
    end
    build ||= Spaceship::ConnectAPI::Build.all(
      client: client,
      app_id: app.id,
      version: version.version_string,
      platform: Spaceship::ConnectAPI::Platform::IOS,
      processing_states: Spaceship::ConnectAPI::Build::ProcessingState::VALID,
      limit: 1
    ).first

    UI.user_error!(
      "Could not infer a selected or valid build for App Store version #{version.version_string}. " \
      "Pass BUILD_NUMBER explicitly."
    ) if build.nil?

    {
      marketing_version: version.version_string,
      build_number: build.version,
      app_version_state: version.app_version_state || version.app_store_state
    }
  end

  # ── PR lanes (no signing) ────────────────────────────────────────────────────

  desc "Run SwiftLint"
  lane :lint do
    sh("cd #{ROOT} && swiftlint lint --strict --no-cache --config .swiftlint.yml")
  end

  desc "Run xcodebuild analyze (static analysis)"
  lane :analyze do
    xcodebuild(
      project:      PROJECT,
      scheme:       SCHEME,
      configuration: "Debug",
      sdk:          "iphonesimulator",
      destination:  "platform=iOS Simulator,name=iPhone 17,OS=latest",
      analyze:      true,
      buildlog_path: "build/logs"
    )
  end

  desc "Run unit tests on simulator"
  lane :test do
    run_tests(
      project:     PROJECT,
      scheme:      SCHEME,
      device:      "iPhone 17",     # available on macos-26 / Xcode 26 runners
      clean:       true,
      disable_concurrent_testing: true,
      output_directory:  "build/test_output",
      output_files: "report.junit",
      output_types: "junit",
      only_testing: ["PicStripTests"],
      fail_build:  true
    )
  end

  # ── Main lanes (signed) ──────────────────────────────────────────────────────

  desc "Sync App Store distribution certificates (readonly on CI)"
  lane :certificates do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Create a temporary keychain to avoid UI prompts on CI
    if ENV["CI"]
      create_keychain(
        name:            "fastlane_tmp_keychain",
        password:        "fastlane_tmp_keychain_password",
        default_keychain: true,
        unlock:          true,
        timeout:         3600,
        lock_when_sleeps: false
      )
    end

    match(
      type:             "appstore",
      app_identifier:   [APP_ID, EXTENSION_ID],
      readonly:         true,
      api_key:          api_key,
      keychain_name:    ENV["CI"] ? "fastlane_tmp_keychain" : nil,
      keychain_password: ENV["CI"] ? "fastlane_tmp_keychain_password" : nil
    )
  end

  desc "Build and export IPA"
  lane :build do
    # Increment build number to CI run number
    build_number = ENV.fetch("BUILD_NUMBER", "1")

    increment_build_number(
      build_number: build_number,
      xcodeproj:    PROJECT
    )

    # Inject MARKETING_VERSION from the semantic-release dry run so the IPA
    # carries the release version without committing generated version bumps.
    marketing_version = ENV.fetch("MARKETING_VERSION", nil)
    version_xcargs = marketing_version ? "MARKETING_VERSION=#{marketing_version}" : ""

    gym(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      clean:             true,
      output_directory:  OUTPUT_DIR,
      output_name:       IPA_NAME,
      export_method:     "app-store",
      xcargs:            version_xcargs,
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          APP_ID       => "match AppStore #{APP_ID}",
          EXTENSION_ID => "match AppStore #{EXTENSION_ID}"
        }
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    certificates
    build

    upload_testflight
  end

  desc "Upload an already-built IPA to TestFlight"
  lane :upload_testflight do
    ipa_path = ENV.fetch("IPA_PATH", "#{OUTPUT_DIR}/#{IPA_NAME}")
    validate_export_compliance

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_testflight(
      ipa:              ipa_path,
      api_key:          api_key,
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Capture App Store screenshots on simulator (reads fastlane/Snapfile)"
  lane :screenshots do |options|
    screenshot_options = {
      # Disable code signing for simulator builds — avoids OCSP certificate
      # validation hangs against Apple servers in headless CI environments.
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
      buildlog_path: "./fastlane/screenshot_logs",
      disable_package_automatic_updates: true,
      sdk: "iphonesimulator",
      skip_package_dependencies_resolution: true
    }

    if options[:device]
      screenshot_options[:devices] = [options[:device]]
    elsif options[:devices]
      screenshot_options[:devices] = options[:devices].split(",").map(&:strip)
    end

    # Optional locale subset. Without this, the lane reads the full locale
    # list from Snapfile (16 locales for App Store submission) — a full
    # 16-locale × 2-device capture takes ~2 hours on macos-26 runners, well
    # past CI timeouts. PR sanity checks pass `languages:en-US`; the full
    # multi-locale capture runs locally or on a dedicated workflow.
    if options[:languages]
      screenshot_options[:languages] = options[:languages].split(",").map(&:strip)
    end

    # Work around fastlane/snapshot emitting OS=26.4 when Xcode needs OS=26.4.1.
    # `xcrun simctl list devices` labels the runtime header "-- iOS 26.4 --"
    # (no patch version), so DeviceManager#simulators sets device.os_version to
    # "26.4".  TestCommandGenerator then builds:
    #   -destination 'platform=iOS Simulator,name=iPhone 17 Pro Max,OS=26.4'
    # which Xcode rejects because it only registers destinations as OS=26.4.1.
    # Switching to id=<UDID> bypasses the version string entirely and is always
    # unambiguous.  Remove this block once fastlane ships a fix for the simctl
    # text-parse regression (fastlane/fastlane#22xxx).
    # Fix the HTML report so iPhone 17 Pro Max and iPad Pro 13-inch (M5) all
    # appear correctly.  The upstream device-name map in reports_generator.rb has no
    # entry for these models; the generic 'iPad Pro' key incidentally matches iPad but
    # the iPhone row is invisible.  We prepend specific entries *before*
    # the broad 'iPad Pro' substring so the lookup breaks on the right key.
    require 'snapshot/reports_generator'
    Snapshot::ReportsGenerator.prepend(Module.new do
      def xcode_9_and_above_device_name_mappings
        {
          'iPhone 17 Pro Max'     => 'iPhone 17 Pro Max',
          'iPad Pro 13-inch (M5)' => 'iPad Pro 13-inch (M5)'
        }.merge(super)
      end
    end)

    require 'snapshot/test_command_generator'
    Snapshot::TestCommandGenerator.singleton_class.prepend(Module.new do
      def destination(devices)
        return ["-destination 'platform=macOS'"] if devices.first.to_s =~ /^Mac/

        os = case devices.first.to_s
             when /^Apple TV/ then 'tvOS'
             when /^Apple Watch/ then 'watchOS'
             else 'iOS'
             end

        os_version = Snapshot.config[:ios_version] || Snapshot::LatestOsVersion.version(os)

        destinations = devices.map do |d|
          device = find_device(d, os_version)
          UI.user_error!("No simulator found named '#{d}' for #{os}") if device.nil?
          "-destination 'platform=#{os} Simulator,id=#{device.udid}'"
        end
        [destinations.join(' ')]
      end
    end)

    capture_ios_screenshots(screenshot_options)
  end

  desc "Compose marketing screenshots from raw captures into ./fastlane/screenshots/processed/"
  lane :process_screenshots do
    # Deliver validates every top-level directory under screenshots_path as a
    # locale. Keep old captured log folders from breaking screenshot uploads.
    sh("rm -rf #{ROOT}/fastlane/screenshots/Logs")

    # Wipe the processed tree before regen. Without this, a change to
    # SCREENSHOT_DISPLAY_ORDER in the Python compositor (or to the screen-key
    # set itself) leaves orphaned PNGs from the previous order alongside the
    # new ones — and ``upload_to_app_store`` would happily ship both, blowing
    # past App Store Connect's 10-screenshot-per-device limit.
    sh("rm -rf #{ROOT}/fastlane/screenshots/processed")

    # The Python compositor handles device framing internally — it draws a
    # matte rounded-rect frame around each raw capture rather than consuming
    # frameit's output. We discover the locales from the directory tree
    # rather than hardcoding the list so adding or removing a locale in
    # Snapfile doesn't require editing the Fastfile too. Paths are absolute
    # via ROOT — Ruby's CWD inside a fastlane lane isn't reliably the
    # project root, and a relative ``Dir.glob`` here silently returns []
    # which would skip the entire compose step without any error message.
    locale_dirs = Dir.glob(File.join(ROOT, "fastlane/screenshots/*/"))
                     .map { |p| File.basename(p) }
                     .reject { |d| d == "processed" || d.start_with?(".") }
    locale_dirs.each do |locale|
      sh("cd #{ROOT} && python3 scripts/process_screenshots.py --locale #{locale}")
    end
  end

  desc "Upload composed marketing screenshots from ./fastlane/screenshots/processed/ to App Store Connect (binary unchanged). LOCAL DEV ONLY — requires an existing 'Prepare for Submission' draft version in App Store Connect. The release deploy workflow stages screenshots before the production approval gate, then submits the current App Store Connect draft as-is."
  lane :upload_screenshots do |options|
    # NOTE: this lane uploads the marketing PNGs already on disk under
    # ``fastlane/screenshots/processed/<locale>/``. Run
    # ``bundle exec fastlane process_screenshots`` first if you need to
    # regenerate from raw captures (the Makefile chains them for the local
    # ``make upload-screenshots`` UX).
    #
    # IMPORTANT: App Store Connect requires a pending "Prepare for Submission"
    # version to exist before screenshots can be uploaded. Create one first in
    # App Store Connect, or use ``use_live_version: true`` only if you
    # understand the consequences (bypasses the review gate). Release deploy
    # stages screenshots through app_store_stage before the manual approval
    # gate; request_review then preserves any edits made in Connect.

    processed_path = "#{ROOT}/fastlane/screenshots/processed"

    allow_partial = options[:allow_partial].to_s == "true"
    unless allow_partial
      # Absolute path so the find runs against the right tree regardless of
      # whatever directory fastlane has chdir'd into for this lane.
      raw_find = sh(
        "find '#{processed_path}' -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' 2>/dev/null || true",
        log: false
      ).strip
      image_paths = raw_find.empty? ? [] : raw_find.split("\n")
      normalized_paths = image_paths.map { |path| path.downcase.gsub(/[^a-z0-9]/, "") }
      missing_devices = SCREENSHOT_DEVICES.reject do |device|
        normalized_device = device.downcase.gsub(/[^a-z0-9]/, "")
        normalized_paths.any? { |path| path.include?(normalized_device) }
      end

      if image_paths.empty? || missing_devices.any?
        UI.user_error!(
          "Refusing to upload screenshots because the local screenshot set is incomplete. " \
          "Missing device screenshots: #{missing_devices.join(', ')}. " \
          "Run `bundle exec fastlane screenshots` for the full App Store set, " \
          "or pass `allow_partial:true` if you intentionally want to replace App Store screenshots with this partial set."
        )
      end
    end

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_app_store(
      api_key:                      api_key,
      screenshots_path:             processed_path,
      skip_binary_upload:           true,
      skip_metadata:                true,
      overwrite_screenshots:        true,   # replace existing shots on re-runs
      run_precheck_before_submit:   false,  # API key can't check IAP; skip it
      precheck_include_in_app_purchases: false,
      force:                        true    # skip interactive HTML diff preview
    )
  end

  desc "Stage metadata, screenshots, and the processed TestFlight build in App Store Connect without submitting"
  lane :app_store_stage do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    accessibility
    validate_export_compliance
    validate_release_notes

    # The binary was already uploaded to TestFlight by the release pipeline.
    # skip_binary_upload: true tells deliver to find the existing build
    # (matched by app_version + build_number) and attach it to the version
    # rather than re-uploading, which would fail with a duplicate-binary error.
    #
    # Screenshots are uploaded here so they are coupled to the exact release
    # tag and commit. The tag-triggered deploy workflow checks out LFS so the
    # processed PNGs from fastlane/screenshots/processed/ are present on disk.
    processed_path = "#{ROOT}/fastlane/screenshots/processed"
    upload_to_app_store(
      api_key:                           api_key,
      app_version:                       ENV["MARKETING_VERSION"],
      build_number:                      ENV["BUILD_NUMBER"],
      skip_binary_upload:                true,
      submit_for_review:                 false,
      automatic_release:                 false,
      phased_release:                    false,
      primary_category:                  APP_STORE_PRIMARY_CATEGORY,
      secondary_category:                APP_STORE_SECONDARY_CATEGORY,
      metadata_path:                     "./fastlane/metadata",
      screenshots_path:                  processed_path,
      skip_screenshots:                  false,
      overwrite_screenshots:             true,   # replace any existing shots for this version
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false,
      force:                             true    # skip interactive HTML diff preview
    )
  end

  desc "Request App Review for the current App Store Connect draft"
  lane :request_review do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    validate_export_compliance

    deliver_options = {
      api_key:                           api_key,
      app_version:                       ENV["MARKETING_VERSION"],
      skip_binary_upload:                true,
      skip_metadata:                     true,
      skip_screenshots:                  true,
      skip_app_version_update:           true,
      submit_for_review:                 true,
      automatic_release:                 true,   # release automatically on approval
      phased_release:                    true,   # roll out over 7 days
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false,
      submission_information:            EXPORT_COMPLIANCE_SUBMISSION,
      force:                             true    # skip interactive HTML diff preview
    }

    # Default release deploy behavior is "submit what's already staged in App
    # Store Connect." Set BUILD_NUMBER only for an intentional override.
    build_number = ENV.fetch("BUILD_NUMBER", "").strip
    deliver_options[:build_number] = build_number unless build_number.empty?

    upload_to_app_store(deliver_options)
  end

  desc "Alias for app_store_stage"
  lane :preflight do
    app_store_stage
  end

  desc "Alias for request_review"
  lane :submit do
    request_review
  end

  desc "Push metadata/review information only to an existing App Store version/build. " \
       "Does not rebuild, upload a binary, or replace screenshots. Defaults to the current " \
       "editable App Store version and its selected build. Set SUBMIT_FOR_REVIEW=true only " \
       "when intentionally resubmitting."
  lane :metadata_only do
    marketing_version = ENV.fetch("MARKETING_VERSION", nil).to_s.strip
    build_number = ENV.fetch("BUILD_NUMBER", nil).to_s.strip
    submit_for_review = ENV.fetch("SUBMIT_FOR_REVIEW", "false").casecmp("true").zero?

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    if marketing_version.empty? || build_number.empty?
      inferred = infer_metadata_target(api_key: api_key)
      marketing_version = inferred[:marketing_version] if marketing_version.empty?
      build_number = inferred[:build_number] if build_number.empty?
      UI.message(
        "Inferred App Store metadata target: #{marketing_version} (#{build_number})" \
        " from state #{inferred[:app_version_state]}"
      )
    end

    UI.user_error!("MARKETING_VERSION is required, e.g. 1.6.2") if marketing_version.empty?
    UI.user_error!("BUILD_NUMBER is required, e.g. 62") if build_number.empty?

    validate_release_notes

    deliver_options = {
      api_key:                           api_key,
      app_version:                       marketing_version,
      build_number:                      build_number,
      skip_binary_upload:                true,
      skip_screenshots:                  true,
      submit_for_review:                 submit_for_review,
      automatic_release:                 false,
      phased_release:                    false,
      primary_category:                  APP_STORE_PRIMARY_CATEGORY,
      secondary_category:                APP_STORE_SECONDARY_CATEGORY,
      metadata_path:                     "./fastlane/metadata",
      run_precheck_before_submit:        false,
      precheck_include_in_app_purchases: false,
      force:                             true
    }
    deliver_options[:submission_information] = EXPORT_COMPLIANCE_SUBMISSION if submit_for_review

    upload_to_app_store(deliver_options)
  end

  desc "Sync App Store Accessibility Nutrition Label declarations"
  lane :accessibility do
    sync_accessibility_declarations(
      app_identifier: APP_ID,
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      config_path: "./fastlane/accessibility_declarations.json"
    )
  end
end
