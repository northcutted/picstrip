require_relative "lib/release_guard"
require "shellwords"

default_platform(:ios)

platform :ios do
  # ── Constants ────────────────────────────────────────────────────────────────
  ROOT          = File.expand_path("..", __dir__)
  APP_ID         = "com.northcutt.PicStrip"
  EXTENSION_ID   = "com.northcutt.PicStrip.ShareExtension"
  SCHEME         = "PicStrip"
  PROJECT        = "PicStrip.xcodeproj"
  OUTPUT_DIR     = "build"
  IPA_NAME       = "PicStrip.ipa"
  # App Store Connect category IDs. Display names like "Photo & Video" are not
  # valid relationship IDs when Fastlane patches app info categories.
  APP_STORE_PRIMARY_CATEGORY = "PHOTO_AND_VIDEO"
  APP_STORE_SECONDARY_CATEGORY = "UTILITIES"
  CI_CONFIG = JSON.parse(File.read(File.join(ROOT, "scripts/ci/config.json"))).freeze
  SCREENSHOT_DEVICES = CI_CONFIG.fetch("screenshot_devices").freeze
  EXPORT_COMPLIANCE_PLISTS = [
    "PicStrip-Info.plist",
    "PicStripShareExtension/Info.plist"
  ].freeze
  EXPORT_COMPLIANCE_SUBMISSION = {
    # PicStrip uses only standard platform encryption, so it does not use
    # non-exempt encryption. Keep this in sync with ITSAppUsesNonExemptEncryption=false.
    export_compliance_uses_encryption: false
  }.freeze

  private_lane :validate_export_compliance do
    require "plist"

    invalid = EXPORT_COMPLIANCE_PLISTS.filter_map do |relative_path|
      path = File.join(ROOT, relative_path)
      plist = Plist.parse_xml(path)
      relative_path unless plist && plist["ITSAppUsesNonExemptEncryption"] == false
    end

    UI.user_error!(
      "Expected ITSAppUsesNonExemptEncryption=false in: #{invalid.join(', ')}"
    ) if invalid.any?
  end

  private_lane :validate_release_notes do
    metadata_root = File.join(ROOT, "fastlane", "metadata")
    locale_dirs = Dir.children(metadata_root)
                     .map { |entry| File.join(metadata_root, entry) }
                     .select { |path| File.directory?(path) }
                     .reject { |path| File.basename(path) == "review_information" }
                     .sort

    missing = locale_dirs.filter_map do |path|
      notes_path = File.join(path, "release_notes.txt")
      File.basename(path) unless File.exist?(notes_path) && !File.read(notes_path).strip.empty?
    end

    UI.user_error!(
      "Missing App Store release_notes.txt for locale(s): #{missing.join(', ')}. " \
      "Render release metadata before app_store_stage."
    ) if missing.any?
  end

  # ── PR lanes (no signing) ────────────────────────────────────────────────────

  desc "Run SwiftLint"
  lane :lint do
    sh("cd #{ROOT} && swiftlint lint --strict --no-cache --config .swiftlint.yml")
  end

  desc "Run xcodebuild analyze (static analysis)"
  lane :analyze do
    xcodebuild(
      project:      PROJECT,
      scheme:       SCHEME,
      configuration: "Debug",
      sdk:          "iphonesimulator",
      destination:  ENV.fetch("TEST_DESTINATION", "platform=iOS Simulator,name=iPhone 17,OS=#{CI_CONFIG['xcode']['runtime']}"),
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      analyze:      true,
      buildlog_path: "build/logs"
    )
  end

  desc "Run unit tests on simulator"
  lane :test do
    run_tests(
      project:     PROJECT,
      scheme:      SCHEME,
      destination: ENV.fetch("TEST_DESTINATION", "platform=iOS Simulator,name=iPhone 17,OS=#{CI_CONFIG['xcode']['runtime']}"),
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      clean:       true,
      disable_concurrent_testing: ENV.fetch("TEST_WORKERS", "1") == "1",
      parallel_testing: ENV.fetch("TEST_WORKERS", "1") != "1",
      concurrent_workers: Integer(ENV.fetch("TEST_WORKERS", "1")),
      result_bundle: true,
      output_directory:  "build/test_output",
      output_files: "report.junit",
      output_types: "junit",
      only_testing: ["PicStripTests"],
      fail_build:  true
    )
  end

  # ── Main lanes (signed) ──────────────────────────────────────────────────────

  desc "Sync App Store distribution certificates (readonly on CI)"
  lane :certificates do
    if ENV["CI"]
      create_keychain(path: ENV.fetch("SIGNING_KEYCHAIN"),
                      password: ENV.fetch("SIGNING_KEYCHAIN_PASSWORD"),
                      default_keychain: false, unlock: true, timeout: 3600)
    end
    match(
      type: "appstore", app_identifier: [APP_ID, EXTENSION_ID], readonly: true,
      git_url: ENV.fetch("MATCH_GIT_URL", "git@github.com:northcutted/picstrip-certs.git"),
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "master"),
      keychain_name: ENV["SIGNING_KEYCHAIN"], keychain_password: ENV["SIGNING_KEYCHAIN_PASSWORD"]
    )
  end

  desc "Build and export the exact release version without changing tracked files"
  lane :build do
    build_number = ENV.fetch("BUILD_NUMBER", "1.1")
    marketing_version = ENV.fetch("MARKETING_VERSION")
    UI.user_error!("Invalid build number") unless build_number.match?(/\A[1-9]\d{0,3}\.[1-9]\d?\z/)
    UI.user_error!("Invalid marketing version") unless marketing_version.match?(/\A\d+\.\d+\.\d+\z/)
    gym(
      project: PROJECT, scheme: SCHEME, configuration: "Release", clean: true,
      output_directory: OUTPUT_DIR, output_name: IPA_NAME,
      archive_path: "#{OUTPUT_DIR}/PicStrip.xcarchive", include_symbols: true,
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store-connect", signingStyle: "manual", manageAppVersionAndBuildNumber: false,
        provisioningProfiles: {APP_ID => "match AppStore #{APP_ID}", EXTENSION_ID => "match AppStore #{EXTENSION_ID}"}
      }
    )
  end

  desc "Upload an already-built IPA to TestFlight"
  lane :upload_testflight do
    ipa_path = File.expand_path(ENV.fetch("IPA_PATH", "#{OUTPUT_DIR}/#{IPA_NAME}"), ROOT)
    validate_export_compliance
    manifest = JSON.parse(File.read(File.expand_path(ENV.fetch("RELEASE_MANIFEST"), ROOT)))
    UI.user_error!("IPA changed after verification") unless Digest::SHA256.file(ipa_path).hexdigest == manifest.fetch("ipa_sha256")
    UI.user_error!("This version/build already exists; resume processing/deployment instead of uploading again") if ReleaseGuard.new(manifest).find_build

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_testflight(
      ipa:              ipa_path,
      api_key:          api_key,
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Capture App Store screenshots on simulator (reads fastlane/Snapfile)"
  lane :screenshots do |options|
    screenshot_options = {
      # Disable code signing for simulator builds — avoids OCSP certificate
      # validation hangs against Apple servers in headless CI environments.
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
      buildlog_path: "./fastlane/screenshot_logs",
      disable_package_automatic_updates: true,
      sdk: "iphonesimulator",
      skip_package_dependencies_resolution: true
    }

    if options[:device]
      screenshot_options[:devices] = [options[:device]]
    elsif options[:devices]
      screenshot_options[:devices] = options[:devices].split(",").map(&:strip)
    end

    # Optional locale subset. Without this, the lane reads the full locale
    # list from Snapfile (16 locales for App Store submission) — a full
    # 16-locale × 2-device capture takes ~2 hours on macos-26 runners, well
    # past CI timeouts. PR sanity checks pass `languages:en-US`; the full
    # multi-locale capture runs locally or on a dedicated workflow.
    if options[:languages]
      screenshot_options[:languages] = options[:languages].split(",").map(&:strip)
    end

    selected_languages = screenshot_options[:languages] || CI_CONFIG.fetch("locales")
    UI.user_error!("Unknown screenshot locale") unless (selected_languages - CI_CONFIG.fetch("locales")).empty?
    screenshot_options[:ios_version] = ENV.fetch("SIMULATOR_RUNTIME", CI_CONFIG.fetch("xcode").fetch("runtime"))
    unless ENV["SIMULATOR_UDIDS"]
      ENV["DEVELOPER_DIR"] = CI_CONFIG.fetch("xcode").fetch("path")
      ENV["SIMULATOR_UDIDS"] = sh("python3", "#{ROOT}/scripts/ci/toolchain.py", "--screenshots", "--destinations-json", log: false).strip
    end
    require 'snapshot/test_command_generator'
    Snapshot::TestCommandGenerator.singleton_class.prepend(Module.new do
      def destination(devices)
        resolved = JSON.parse(ENV.fetch("SIMULATOR_UDIDS"))
        destinations = devices.map do |name|
          id = resolved.fetch(name)
          raise "Invalid simulator UUID" unless id.match?(/\A[0-9A-Fa-f-]{36}\z/)
          "-destination 'platform=iOS Simulator,id=#{id}'"
        end
        [destinations.join(' ')]
      end
    end)

    capture_ios_screenshots(screenshot_options)
  end

  desc "Compose marketing screenshots from raw captures into ./fastlane/screenshots/processed/"
  lane :process_screenshots do
    # Deliver validates every top-level directory under screenshots_path as a
    # locale. Keep old captured log folders from breaking screenshot uploads.
    sh("rm -rf #{ROOT}/fastlane/screenshots/Logs")

    # Replace only captured locales, removing stale screen names before composing.
    # Full locale/device coverage is required before staging.

    # The Python compositor handles device framing internally — it draws a
    # matte rounded-rect frame around each raw capture rather than consuming
    # frameit's output. We discover the locales from the directory tree
    # rather than hardcoding the list so adding or removing a locale in
    # Snapfile doesn't require editing the Fastfile too. Paths are absolute
    # via ROOT — Ruby's CWD inside a fastlane lane isn't reliably the
    # project root, and a relative ``Dir.glob`` here silently returns []
    # which would skip the entire compose step without any error message.
    locale_dirs = Dir.glob(File.join(ROOT, "fastlane/screenshots/*/"))
                     .map { |p| File.basename(p) }
                     .reject { |d| d == "processed" || d.start_with?(".") }
    locale_dirs &= CI_CONFIG.fetch("locales")
    locale_dirs.each do |locale|
      FileUtils.rm_rf(File.join(ROOT, "fastlane/screenshots/processed", locale))
      sh("cd #{Shellwords.escape(ROOT)} && python3 scripts/process_screenshots.py --locale #{Shellwords.escape(locale)}")
    end
  end

  desc "Upload composed marketing screenshots from ./fastlane/screenshots/processed/ to App Store Connect (binary unchanged). LOCAL DEV ONLY — requires an existing 'Prepare for Submission' draft version in App Store Connect. The release deploy workflow stages screenshots before the production approval gate, then submits the current App Store Connect draft as-is."
  lane :upload_screenshots do |options|
    # NOTE: this lane uploads the marketing PNGs already on disk under
    # ``fastlane/screenshots/processed/<locale>/``. Run
    # ``bundle exec fastlane process_screenshots`` first if you need to
    # regenerate from raw captures (the Makefile chains them for the local
    # ``make upload-screenshots`` UX).
    #
    # IMPORTANT: App Store Connect requires a pending "Prepare for Submission"
    # version to exist before screenshots can be uploaded. Create one first in
    # App Store Connect, or use ``use_live_version: true`` only if you
    # understand the consequences (bypasses the review gate). Release deploy
    # stages screenshots through app_store_stage before the manual approval
    # gate; request_review then preserves any edits made in Connect.

    processed_path = "#{ROOT}/fastlane/screenshots/processed"

    allow_partial = options[:allow_partial].to_s == "true"
    unless allow_partial
      # Absolute path so the find runs against the right tree regardless of
      # whatever directory fastlane has chdir'd into for this lane.
      raw_find = sh(
        "find '#{processed_path}' -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' 2>/dev/null || true",
        log: false
      ).strip
      image_paths = raw_find.empty? ? [] : raw_find.split("\n")
      normalized_paths = image_paths.map { |path| path.downcase.gsub(/[^a-z0-9]/, "") }
      missing_devices = SCREENSHOT_DEVICES.reject do |device|
        normalized_device = device.downcase.gsub(/[^a-z0-9]/, "")
        normalized_paths.any? { |path| path.include?(normalized_device) }
      end

      if image_paths.empty? || missing_devices.any?
        UI.user_error!(
          "Refusing to upload screenshots because the local screenshot set is incomplete. " \
          "Missing device screenshots: #{missing_devices.join(', ')}. " \
          "Run `bundle exec fastlane screenshots` for the full App Store set, " \
          "or pass `allow_partial:true` if you intentionally want to replace App Store screenshots with this partial set."
        )
      end
    end

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content:  ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_app_store(
      api_key:                      api_key,
      screenshots_path:             processed_path,
      skip_binary_upload:           true,
      skip_metadata:                true,
      overwrite_screenshots:        true,   # replace existing shots on re-runs
      run_precheck_before_submit:   false,  # API key can't check IAP; skip it
      precheck_include_in_app_purchases: false,
      force:                        true    # skip interactive HTML diff preview
    )
  end

  private_lane :release_manifest do
    manifest = JSON.parse(File.read(File.expand_path(ENV.fetch("RELEASE_MANIFEST"), ROOT)))
    UI.user_error!("Expected a processed release manifest") unless manifest["schema_version"] == 2 && manifest["processing_state"] == "VALID"
    manifest
  end

  desc "Wait on Linux for the exact uploaded build to finish processing"
  lane :wait_processing do
    manifest = JSON.parse(File.read(File.expand_path(ENV.fetch("RELEASE_MANIFEST"), ROOT)))
    status = ReleaseGuard.new(manifest).wait_for_processing
    ReleaseGuard.save(File.expand_path(ENV.fetch("PROCESSING_RECEIPT", "testflight-status.json"), ROOT), status)
  end

  desc "Stage verified metadata, screenshots, and the exact processed build"
  lane :app_store_stage do
    manifest = release_manifest
    guard = ReleaseGuard.new(manifest)
    existing = guard.find_build
    UI.user_error!("Processed App Store build does not match release") unless existing && existing["id"] == manifest.fetch("app_store_build_id") && existing.dig("attributes", "processingState") == "VALID"
    api_key = app_store_connect_api_key(key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"], issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"], key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"])
    validate_export_compliance
    validate_release_notes
    sh("python3", "#{ROOT}/scripts/ci/evidence.py", "metadata", "#{ROOT}/fastlane/metadata")
    sh("python3", "#{ROOT}/scripts/ci/evidence.py", "screenshots", "#{ROOT}/fastlane/screenshots/processed", "--output", "#{ROOT}/build/staged-screenshots.json")
    # A retry after submission preserves the draft and its already-selected build.
    versions = guard.list("/v1/apps/#{guard.app_id}/appStoreVersions", "filter[versionString]" => manifest.fetch("version"), "filter[platform]" => "IOS")
    state = versions.first&.dig("attributes", "appVersionState") || versions.first&.dig("attributes", "appStoreState")
    if ReleaseGuard::SUBMITTED_STATES.include?(state)
      ReleaseGuard.save(File.expand_path(ENV.fetch("STAGED_SNAPSHOT", "build/staged-snapshot.json"), ROOT), guard.snapshot)
      next
    end
    accessibility
    upload_to_app_store(
      api_key: api_key, app_version: manifest.fetch("version"), build_number: manifest.fetch("build_number"),
      skip_binary_upload: true, submit_for_review: false, automatic_release: false, phased_release: false,
      primary_category: APP_STORE_PRIMARY_CATEGORY, secondary_category: APP_STORE_SECONDARY_CATEGORY,
      metadata_path: "./fastlane/metadata", screenshots_path: "#{ROOT}/fastlane/screenshots/processed",
      skip_screenshots: false, overwrite_screenshots: true, run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false, force: true
    )
    ReleaseGuard.save(File.expand_path(ENV.fetch("STAGED_SNAPSHOT", "build/staged-snapshot.json"), ROOT), guard.snapshot)
  end

  desc "Submit the verified build after approval, recording permitted metadata edits"
  lane :request_review do
    UI.user_error!("CI submission requires the production environment") if ENV["CI"] && ENV["RELEASE_ENVIRONMENT"] != "production"
    manifest = release_manifest
    guard = ReleaseGuard.new(manifest)
    current = guard.snapshot
    before = JSON.parse(File.read(File.expand_path(ENV.fetch("STAGED_SNAPSHOT"), ROOT)))
    changes = ReleaseGuard.diff(before, current)
    receipt_path = File.expand_path(ENV.fetch("SUBMISSION_RECEIPT", "build/submission-receipt.json"), ROOT)
    receipt = {"manifest_sha256" => Digest::SHA256.file(File.expand_path(ENV.fetch("RELEASE_MANIFEST"), ROOT)).hexdigest,
               "snapshot" => current, "changes_since_staging" => changes, "status" => "ready"}
    ReleaseGuard.save(receipt_path, receipt)
    state = current.fetch("version_attributes")["appVersionState"] || current.fetch("version_attributes")["appStoreState"]
    unless ReleaseGuard::SUBMITTED_STATES.include?(state)
      api_key = app_store_connect_api_key(key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"], issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"], key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"])
      validate_export_compliance
      # Read back immediately before submission; never silently replace another selected build.
      guard.verify_selected_build!
      upload_to_app_store(
        api_key: api_key, app_version: manifest.fetch("version"), build_number: manifest.fetch("build_number"),
        skip_binary_upload: true, skip_metadata: true, skip_screenshots: true, skip_app_version_update: true,
        submit_for_review: true, automatic_release: true, phased_release: true,
        run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
        submission_information: EXPORT_COMPLIANCE_SUBMISSION, force: true
      )
    end
    receipt["status"] = "submitted"
    receipt["readback"] = guard.snapshot
    ReleaseGuard.save(receipt_path, receipt)
  end

  desc "Update metadata for a verified release; review always uses request_review"
  lane :metadata_only do
    UI.user_error!("Use the production-gated request_review lane") if ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
    manifest = release_manifest
    guard = ReleaseGuard.new(manifest)
    guard.verify_selected_build!
    validate_release_notes
    api_key = app_store_connect_api_key(key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"], issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"], key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"])
    upload_to_app_store(
      api_key: api_key, app_version: manifest.fetch("version"), build_number: manifest.fetch("build_number"),
      skip_binary_upload: true, skip_screenshots: true, submit_for_review: false,
      primary_category: APP_STORE_PRIMARY_CATEGORY, secondary_category: APP_STORE_SECONDARY_CATEGORY,
      metadata_path: "./fastlane/metadata", run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false, force: true
    )
    ReleaseGuard.save(File.expand_path(ENV.fetch("STAGED_SNAPSHOT", "build/staged-snapshot.json"), ROOT), guard.snapshot)
  end

  lane :preflight do
    app_store_stage
  end

  lane :submit do
    request_review
  end

  desc "Sync App Store Accessibility Nutrition Label declarations"
  lane :accessibility do
    sync_accessibility_declarations(
      app_identifier: APP_ID,
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      config_path: "./fastlane/accessibility_declarations.json"
    )
  end
end
