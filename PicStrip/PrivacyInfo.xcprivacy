<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        PicStrip Privacy Manifest
        ─────────────────────────
        PicStrip processes images entirely on-device. It does not transmit any
        data to external servers, does not use advertising or analytics SDKs,
        and does not track users in any way. Face detection uses temporary
        on-device face rectangles only; no face data is collected, stored,
        transmitted, or shared.

        Required reason API usage is documented below per Apple's mandate.
    -->

    <!-- No tracking of any kind. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No data is collected and sent off-device. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- No tracking domains are contacted. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Required-reason APIs used by PicStrip:

        File timestamp APIs (POSIX / Foundation) — used by ImageIO internally
        when encoding image files. Reason: C617.1 (file creation/modification
        date is written as part of standard image encoding; not used to derive
        a fingerprint or identify the user).

        UserDefaults — used for app-local lifetime counters and the App Group
        handoff that lets App Shortcuts open the batch picker in PicStrip.
        Reasons: CA92.1 (app-only defaults) and 1C8F.1 (same App Group).
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
