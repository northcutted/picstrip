<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        PicStrip Privacy Manifest
        ─────────────────────────
        PicStrip performs image analysis and redaction on-device, without an
        app-operated upload service, advertising SDKs or analytics SDKs.
        Face-detection rectangles remain in the current editing session.
        Users can save or share images with destinations of their choice.
        Protected temporary export and extension-handoff files expire.

        Required reason API usage is documented below per Apple's mandate.
    -->

    <!-- No tracking of any kind. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No developer or third-party SDK data collection. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- No tracking domains are contacted. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Required-reason APIs used by PicStrip:

        C617.1: timestamps and file sizes inside the app/app-group containers
        support protected-file expiry, bounded reads and image encoding.
        3B52.1: file sizes of images explicitly chosen through system pickers
        are checked before reading. File metadata is not used to fingerprint.
        35F9.1: elapsed time between live-camera frames limits local analysis
        frequency and measures how fast the camera moves, to keep the overlay
        on its content. Uptime and frame timing are not stored or transmitted.

        PicStrip does not read or write UserDefaults. Editing sessions have no
        persistent history; private handoff/export files have bounded lifetimes.
        The one thing kept between launches is the user's Always Cover list of
        words to cover: a single file in the app container with complete file
        protection, excluded from backups, never shared or transmitted.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
                <string>3B52.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
