          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip a besoin d’accéder à votre photothèque pour remplacer une photo ou une vidéo originale lorsque vous le demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip ha bisogno di accedere alla tua libreria foto per sostituire una foto o un video originale quando lo richiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStripは、リクエストに応じて元の写真またはビデオを置き換えるために、写真ライブラリへのアクセスを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청 시 원본 사진이나 비디오를 교체하려면 PicStrip이 사진 보관함에 접근할 수 있어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip heeft toegang tot je fotobibliotheek nodig om een originele foto of video te vervangen wanneer je daarom vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip potrzebuje dostępu do biblioteki zdjęć, aby na Twoje żądanie zastąpić oryginalne zdjęcie lub wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PicStrip precisa de acesso à sua fototeca para substituir uma foto ou um vídeo original quando você pedir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PicStrip necessita de acesso à sua fototeca para substituir uma fotografia ou um vídeo original quando o pedir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip behöver åtkomst till ditt bildbibliotek för att kunna ersätta en originalbild eller originalvideo när du ber om det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip, istediğinizde orijinal bir fotoğrafı veya videoyu değiştirebilmek için fotoğraf arşivinize erişmek ister."
          }
        },
        "zh-Hans" : {
