    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج PicStrip إلى الوصول إلى مكتبة الصور لاستبدال الصورة الأصلية أو الفيديو الأصلي عند طلب ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip benötigt Zugriff auf deine Fotomediathek, um auf Wunsch das Originalfoto oder -video zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "PicStrip needs access to your photo library to replace an original photo or video when you ask it to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip necesita acceder a tu fototeca para reemplazar la foto o el vídeo original cuando lo pidas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
