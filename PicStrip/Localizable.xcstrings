    "Detection limits are intentional. We only flag patterns specific enough to keep false positives rare." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدود الكشف مقصودة. نحن نعلم الأنماط التي تتميز بخصوصية كافية للحفاظ على ندرة الإيجابيات الكاذبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennungsgrenzen sind absichtlich gesetzt. Wir markieren nur Muster, die spezifisch genug sind, um Fehlalarme selten zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los límites de detección son intencionales. Solo señalamos patrones lo suficientemente específicos para mantener raros los falsos positivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les limites de détection sont intentionnelles. Nous ne signalons que les motifs suffisamment spécifiques pour que les faux positifs restent rares."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I limiti di rilevamento sono intenzionali. Segnaliamo solo i modelli sufficientemente specifici per mantenere rari i falsi positivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出の制限は意図的なものです。誤検知を稀に抑えるため、特定性の高いパターンのみを検知しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐지 한도는 의도된 것입니다. 오탐을 드물게 유지하기 위해 충분히 구체적인 패턴만 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectielimieten zijn opzettelijk. We markeren alleen patronen die specifiek genoeg zijn om valse positieven zeldzaam te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granice wykrywania są zamierzone. Oznaczamy tylko wzory na tyle specyficzne, by ograniczyć liczbę fałszywych alarmów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os limites de detecção são intencionais. Só sinalizamos padrões suficientemente específicos para manter os falsos positivos raros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os limites de deteção são intencionais. Só sinalizamos padrões suficientemente específicos para manter os falsos positivos raros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detektionsgränser är avsiktliga. Vi markerar endast mönster som är tillräckligt specifika för att hålla antalet falska träffar lågt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algılama sınırları kasıtlıdır. Yanlış pozitiflerin nadir olması için yeterince spesifik desenleri işaretliyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测限制是有意设置的。我们仅标记足够特定的模式,以保持误报率较低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測限制是刻意設定的。我們只標記足夠具體以保持誤報率低的模式。"
          }
        }
      }
    },
