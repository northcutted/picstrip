    "Keeps original format. OS may re-encode and inject basic headers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keeps original format. OS may re-encode and inject basic headers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el formato original. El sistema operativo puede recodificar e insertar encabezados básicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le format original. Le système d’exploitation peut réencoder et insérer des en-têtes basiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält das Originalformat bei. Das Betriebssystem kann es neu kodieren und grundlegende Header einfügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のフォーマットを保持します。OSが再エンコードし、基本的なヘッダーを挿入する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持原始格式。操作系统可能会重新编码并注入基本头信息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o formato original. O sistema operativo pode reencodar e inserir cabeçalhos básicos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 형식 유지. 운영체제가 다시 인코딩하고 기본 헤더를 삽입할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene il formato originale. Il sistema operativo potrebbe riconvertire e inserire intestazioni basilari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoudt het originele formaat. Het besturingssysteem kan mogelijk opnieuw coderen en basisheaders toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje oryginalny format. System operacyjny może ponownie kodować i dodawać podstawowe nagłówki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller ursprungligt format. Operativsystemet kan koda om och infoga grundläggande rubriker."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal formatı korur. İşletim sistemi yeniden kodlayabilir ve temel başlıklar ekleyebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ بالتنسيق الأصلي. قد يعيد نظام التشغيل ترميز الملف ويضيف رؤوساً أساسية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持原始格式。作業系統可能會重新編碼並插入基本標頭。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o formato original. O sistema operativo pode reencodar e inserir cabeçalhos básicos."
          }
        }
      }
    },
