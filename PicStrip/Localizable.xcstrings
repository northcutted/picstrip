    "The cleaned copy is a still image. Keep your original if you need Live Photo motion or editing history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخة المنظَّفة صورة ثابتة. احتفظ بالأصل إذا كنت تحتاج إلى حركة Live Photo أو سجل التحرير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die bereinigte Kopie ist ein Standbild. Behalte das Original, wenn du Live-Photo-Bewegung oder den Bearbeitungsverlauf benötigst."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia limpia es una imagen fija. Conserva el original si necesitas el movimiento de Live Photo o el historial de edición."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia limpia es una imagen fija. Conserva el original si necesitas el movimiento de Live Photo o el historial de edición."
