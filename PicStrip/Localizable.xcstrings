          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Choisissez une photo ou une vidéo** dans votre photothèque, capturez-en une avec l’appareil photo de PicStrip, importez-la depuis Fichiers ou faites glisser une image directement sur PicStrip."
          }
        },
        "it" : {
          "stringUnit" : {
