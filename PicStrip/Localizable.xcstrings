          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informacje kontekstowe. Ryzyko ujawnienia zależy od odbiorcy. Daty, adresy URL, kody kreskowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informações de contexto. O risco da exposição depende de quem recebe. Datas, URLs, códigos de barras."
          }
