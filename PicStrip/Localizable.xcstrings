    "Hidden details could not be removed from this video, so it was not kept." : {
      "comment" : "Error: the cleaned video still had location, device or date metadata, so it was discarded.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إزالة التفاصيل المخفية من هذا الفيديو، لذا لم يُحتفظ به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Details konnten aus diesem Video nicht entfernt werden, daher wurde es nicht behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido eliminar los detalles ocultos de este vídeo, así que no se ha conservado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron eliminar los detalles ocultos de este video, así que no se conservó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les détails cachés n’ont pas pu être supprimés de cette vidéo, elle n’a donc pas été conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile rimuovere i dettagli nascosti da questo video, quindi non è stato conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオから隠れた情報を削除できなかったため、保持しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비디오에서 숨겨진 정보를 제거할 수 없어 보관하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen gegevens konden niet uit deze video worden verwijderd, dus is hij niet bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć ukrytych danych z tego wideo, więc go nie zachowano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover os detalhes ocultos deste vídeo, então ele não foi mantido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover os detalhes ocultos deste vídeo, por isso não foi mantido."
          }
        },
        "sv" : {
          "stringUnit" : {
