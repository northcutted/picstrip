    "Apply a single privacy policy to all of them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica una única política de privacidad para todas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてに単一のプライバシーポリシーを適用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有内容应用单一隐私政策。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar uma única política de privacidade a todos eles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두에게 단일 개인정보 보호정책을 적용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica una singola politica sulla privacy a tutti loro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas een enkel privacybeleid toe op ze allemaal."
          }
        },
        "pl": {
