    "California-style plates detected structurally; other formats require a nearby plate label" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم كشف اللوحات على نمط كاليفورنيا بنيويًا؛ وتتطلب التنسيقات الأخرى وجود تسمية لوحة قريبة"
          }
        },
        "de" : {
          "stringUnit" : {
