          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o PicStrip em até 15 minutos para revisar o original e escolher o que cobrir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
