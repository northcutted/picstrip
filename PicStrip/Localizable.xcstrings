    "California-style plates detected structurally; other formats require a nearby plate label" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم كشف اللوحات على نمط كاليفورنيا بنيويًا؛ وتتطلب التنسيقات الأخرى وجود تسمية لوحة قريبة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kennzeichen im kalifornischen Format werden strukturell erkannt; andere Formate erfordern eine Kennzeichen-Angabe in der Nähe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las matrículas de estilo californiano se detectan por su estructura; otros formatos requieren una etiqueta de matrícula cercana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaques de style californien détectées par leur structure ; les autres formats exigent une mention de plaque à proximité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le targhe in stile California vengono rilevate in base alla struttura; gli altri formati richiedono un’etichetta di targa nelle vicinanze"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カリフォルニア州式のプレートは構造から検出。ほかの形式は近くにプレートを示す表記が必要"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘리포니아 형식 번호판은 구조만으로 감지하며, 다른 형식은 주변에 번호판 관련 문구가 있어야 합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kentekenplaten in Californische stijl worden structureel gedetecteerd; andere formaten hebben een kentekenlabel in de buurt nodig"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablice w stylu kalifornijskim rozpoznawane strukturalnie; inne formaty wymagają etykiety tablicy w pobliżu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placas no padrão da Califórnia são detectadas pela estrutura; outros formatos exigem um rótulo de placa por perto"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As matrículas ao estilo da Califórnia são detetadas pela estrutura; os outros formatos exigem uma etiqueta de matrícula nas proximidades"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreringsskyltar av Kalifornientyp hittas utifrån strukturen; andra format kräver en skyltmärkning i närheten"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaliforniya tipi plakalar yapısal olarak algılanır; diğer biçimler yakınında bir plaka etiketi bulunmasını gerektirir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按结构识别加州式车牌；其他格式需要附近有车牌标签"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加州樣式的車牌可依結構偵測；其他格式需要附近有車牌標示"
          }
        }
      }
    },
