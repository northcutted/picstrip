    "Faces and text in the video stay visible: PicStrip removes hidden details only." : {
      "comment" : "Note on the video screen: frames are not covered, only metadata is removed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الوجوه والنصوص في الفيديو ظاهرة: يزيل PicStrip التفاصيل المخفية فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichter und Text im Video bleiben sichtbar: PicStrip entfernt nur versteckte Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras y el texto del vídeo siguen visibles: PicStrip solo elimina los detalles ocultos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras y el texto del video siguen visibles: PicStrip solo elimina los detalles ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visages et le texte de la vidéo restent visibles : PicStrip ne supprime que les détails cachés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volti e testo nel video restano visibili: PicStrip rimuove solo i dettagli nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ内の顔や文字はそのまま見えます。PicStripが削除するのは隠れた情報だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 속 얼굴과 텍스트는 그대로 보입니다. PicStrip은 숨겨진 정보만 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezichten en tekst in de video blijven zichtbaar: PicStrip verwijdert alleen verborgen gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twarze i tekst w wideo pozostają widoczne: PicStrip usuwa tylko ukryte dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rostos e textos no vídeo continuam visíveis: o PicStrip remove apenas os detalhes ocultos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rostos e texto no vídeo continuam visíveis: o PicStrip remove apenas os detalhes ocultos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansikten och text i videon syns fortfarande: PicStrip tar bara bort dolda uppgifter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videodaki yüzler ve metinler görünür kalır: PicStrip yalnızca gizli ayrıntıları kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频中的面孔和文字仍然可见：PicStrip 只移除隐藏的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片中的臉孔和文字仍然可見：PicStrip 只會移除隱藏的資訊。"
          }
        }
      }
    },
    "Faces and text were covered automatically, and some can be missed. Watch the copy before you share it." : {
      "comment" : "Note on the cleaned-video screen when something was covered.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُجبت الوجوه والنصوص تلقائيًا، وقد يفوت بعضها. شاهد النسخة قبل مشاركتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichter und Text wurden automatisch verdeckt, dabei kann etwas übersehen werden. Sieh dir die Kopie an, bevor du sie teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras y el texto se han censurado automáticamente y algo puede pasarse por alto. Mira la copia antes de compartirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras y el texto se censuraron automáticamente y algo puede pasarse por alto. Mira la copia antes de compartirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visages et le texte ont été masqués automatiquement, et certains peuvent avoir été manqués. Regardez la copie avant de la partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volti e testo sono stati coperti automaticamente e qualcosa può sfuggire. Guarda la copia prima di condividerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔と文字は自動的にマスクされましたが、見逃しがある場合があります。共有する前にコピーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼굴과 텍스트가 자동으로 가려졌지만 일부를 놓쳤을 수 있습니다. 공유하기 전에 사본을 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezichten en tekst zijn automatisch afgedekt en er kan iets zijn gemist. Bekijk de kopie voordat je deze deelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twarze i tekst zostały zamazane automatycznie, a coś mogło zostać pominięte. Obejrzyj kopię przed udostępnieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rostos e textos foram ocultados automaticamente, e algo pode ter passado despercebido. Assista à cópia antes de compartilhá-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rostos e o texto foram ocultados automaticamente, e algo pode ter escapado. Veja a cópia antes de a partilhar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansikten och text maskerades automatiskt, och något kan ha missats. Titta på kopian innan du delar den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzler ve metinler otomatik olarak karartıldı; bazıları gözden kaçmış olabilir. Paylaşmadan önce kopyayı izleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面孔和文字已自动遮盖，但可能有遗漏。共享前请先观看副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "臉孔和文字已自動遮蓋，但可能有遺漏。分享前請先觀看拷貝。"
          }
        }
      }
    },
    "Faces are found automatically and one can be missed — small, turned away, or on screen for a moment. Watch the preview before you share." : {
      "comment" : "Footer under the list of faces found in a video.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعثر على الوجوه تلقائيًا وقد يفوت أحدها — إن كان صغيرًا أو مُشاحًا أو ظهر للحظة. شاهد المعاينة قبل المشاركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichter werden automatisch gefunden, und eines kann übersehen werden – wenn es klein ist, abgewandt oder nur kurz zu sehen. Sieh dir die Vorschau an, bevor du teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras se detectan automáticamente y alguna puede pasarse por alto: si es pequeña, está de lado o aparece un instante. Mira la vista previa antes de compartir."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las caras se detectan automáticamente y alguna puede pasarse por alto: si es pequeña, está de lado o aparece un instante. Mira la vista previa antes de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visages sont détectés automatiquement et l’un d’eux peut être manqué : petit, de profil ou visible un instant. Regardez l’aperçu avant de partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I volti vengono trovati automaticamente e qualcuno può sfuggire: se è piccolo, girato o visibile solo per un istante. Guarda l’anteprima prima di condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔は自動的に検出されますが、小さい顔、横を向いた顔、一瞬だけ映る顔は見逃されることがあります。共有する前にプレビューを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼굴은 자동으로 찾으며, 작거나 고개를 돌렸거나 잠깐만 보이는 얼굴은 놓칠 수 있습니다. 공유하기 전에 미리보기를 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezichten worden automatisch gevonden en er kan er een worden gemist: klein, afgewend of maar even in beeld. Bekijk de voorvertoning voordat je deelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twarze są wykrywane automatycznie i któraś może zostać pominięta — mała, odwrócona lub widoczna tylko przez chwilę. Obejrzyj podgląd przed udostępnieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rostos são encontrados automaticamente e algum pode passar despercebido: pequeno, virado ou na tela só por um instante. Assista à pré-visualização antes de compartilhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rostos são encontrados automaticamente e algum pode escapar: pequeno, de lado ou no ecrã só por um instante. Veja a pré-visualização antes de partilhar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansikten hittas automatiskt och något kan missas – litet, bortvänt eller bara i bild ett ögonblick. Titta på förhandsvisningen innan du delar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzler otomatik olarak bulunur ve küçük, başka yöne dönük ya da yalnızca bir an görünen bir yüz gözden kaçabilir. Paylaşmadan önce önizlemeyi izleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面孔会被自动找到，但可能会漏掉较小、侧转或只出现片刻的面孔。共享前请先观看预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "臉孔會自動找出，但可能會漏掉較小、轉向一側或只出現片刻的臉孔。分享前請先觀看預覽。"
          }
        }
      }
    },
