    "Financial identifiers can expose accounts or enable fraud when shared with the wrong audience." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لمُعرفات المالية أن تكشف الحسابات أو تتيح الاحتيال عند مشاركتها مع الجمهور الخطأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzielle Kennungen können Konten offenlegen oder Betrug ermöglichen, wenn sie mit der falschen Zielgruppe geteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Financial identifiers can expose accounts or enable fraud when shared with the wrong audience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los identificadores financieros pueden exponer cuentas o facilitar fraudes si se comparten con la audiencia incorrecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financial identifiers can expose accounts or enable fraud when shared with the wrong audience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli identificatori finanziari possono esporre conti o facilitare frodi se condivisi con il pubblico sbagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金融情報識別子は、不適切な相手と共有されると口座の暴露や詐欺の原因となる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재무 식별자는 잘못된 대상과 공유할 경우 계정을 노출하거나 사기를 가능하게 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financiële identificatoren kunnen accounts blootstellen of fraude mogelijk maken wanneer ze met de verkeerde doelgroep worden gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identyfikatory finansowe mogą ujawnić konta lub umożliwić oszustwa, gdy są udostępniane niewłaściwym odbiorcom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificadores financeiros podem expor contas ou permitir fraudes quando compartilhados com o público errado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificadores financeiros podem expor contas ou permitir fraudes quando partilhados com o público errado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansiella identifierare kan exponera konton eller möjliggöra bedrägeri när de delas med fel målgrupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansal tanımlayıcılar, yanlış kişilerle paylaşıldığında hesapları açığa çıkarabilir veya dolandırıcılığa olanak sağlayabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金融标识符如果与错误对象共享,可能会暴露账户或导致欺诈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金融識別碼若與錯誤的對象分享,可能會暴露帳戶或導致詐騙行為發生。"
          }
        }
      }
    },
