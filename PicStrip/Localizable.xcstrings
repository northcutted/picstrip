    "The motion could not be kept, so the photo was saved as a still." : {
      "comment" : "Shown when saving a Live Photo with its motion failed and a still was saved instead.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاحتفاظ بالحركة، لذا حُفظت الصورة كصورة ثابتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewegung konnte nicht behalten werden, daher wurde das Foto als Standbild gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conservar el movimiento, así que la foto se ha guardado como imagen fija."
