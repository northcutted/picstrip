    "No ads, usage analytics, or third-party crash reporting. PicStrip does not send your activity to a developer-operated service." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا إعلانات أو تحليلات استخدام أو تقارير أعطال من جهات خارجية. لا يرسل PicStrip نشاطك إلى خدمة يشغّلها المطوّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, Nutzungsanalyse oder Absturzberichte durch Drittanbieter. PicStrip sendet deine Aktivitäten nicht an einen vom Entwickler betriebenen Dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, análisis de uso ni informes de fallos de terceros. PicStrip no envía tu actividad a un servicio del desarrollador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, análisis de uso ni informes de fallas de terceros. PicStrip no envía tu actividad a un servicio del desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans publicité, analyse d’utilisation ni rapport de plantage tiers. PicStrip n’envoie pas votre activité à un service exploité par le développeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna pubblicità, analisi dell’utilizzo o segnalazione degli arresti anomali di terze parti. PicStrip non invia la tua attività a un servizio gestito dallo sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告、利用状況の分析、第三者によるクラッシュ報告はありません。PicStripは利用状況を開発者のサービスに送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고, 사용 분석, 타사 충돌 보고가 없습니다. PicStrip은 사용 활동을 개발자가 운영하는 서비스로 보내지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen advertenties, gebruiksanalyses of crashrapportage van derden. PicStrip stuurt je activiteit niet naar een dienst van de ontwikkelaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez reklam, analizy użycia i raportowania awarii przez firmy trzecie. PicStrip nie wysyła Twojej aktywności do usługi prowadzonej przez dewelopera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem anúncios, análise de uso ou relatórios de falhas de terceiros. O PicStrip não envia sua atividade a um serviço operado pelo desenvolvedor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
