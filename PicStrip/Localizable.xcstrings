          }
        }
      }
    },
    "Open PicStrip within 15 minutes to review the original and choose what to cover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح PicStrip خلال 15 دقيقة لمراجعة الأصل واختيار ما تريد تغطيته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne PicStrip innerhalb von 15 Minuten, um das Original zu prüfen und auszuwählen, was verdeckt wird."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre PicStrip en los próximos 15 minutos para revisar el original y elegir qué censurar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre PicStrip en los próximos 15 minutos para revisar el original y elegir qué censurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez PicStrip dans les 15 minutes pour vérifier l’original et choisir quoi masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri PicStrip entro 15 minuti per controllare l’originale e scegliere cosa coprire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15分以内にPicStripを開き、元画像を確認して隠す内容を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15분 안에 PicStrip을 열어 원본을 검토하고 가릴 내용을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open PicStrip binnen 15 minuten om het origineel te controleren en te kiezen wat je afdekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
