    "The face is blurred under the emoji too, so nothing shows through around it." : {
      "comment" : "Note in the emoji picker for a face in a video.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُموَّه الوجه تحت الإيموجي أيضًا، فلا يظهر شيء من حوله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dem Emoji wird das Gesicht zusätzlich weichgezeichnet, sodass drumherum nichts durchscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cara también se desenfoca bajo el emoji, así que no se ve nada alrededor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cara también se desenfoca bajo el emoji, así que no se ve nada alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le visage est aussi flouté sous l’emoji : rien ne transparaît autour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il volto viene sfocato anche sotto l’emoji, così intorno non si vede nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵文字の下の顔もぼかされるため、周りから透けて見えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이모티콘 아래의 얼굴도 흐리게 처리되므로 주변으로 아무것도 비치지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gezicht wordt onder de emoji ook vervaagd, zodat er rondom niets doorheen schijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twarz pod emoji jest też rozmyta, więc wokół nic nie prześwituje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rosto também é desfocado sob o emoji, então nada aparece ao redor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rosto também é desfocado sob o emoji, por isso nada se vê à volta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansiktet görs också suddigt under emojin, så inget syns runt den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüz, emojinin altında da bulanıklaştırılır; böylece çevresinden hiçbir şey görünmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表情符号下方的面孔也会被模糊处理，因此周围不会透出任何内容。"
