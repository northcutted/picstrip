    },
    "Could not create a CGImageSource from the supplied data. The data may be corrupt or an unsupported format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create a CGImageSource from the supplied data. The data may be corrupt or an unsupported format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear un CGImageSource a partir de los datos proporcionados. Los datos pueden estar corruptos o ser un formato no soportado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une CGImageSource à partir des données fournies. Les données peuvent être corrompues ou dans un format non pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte keine CGImageSource aus den bereitgestellten Daten erstellen. Die Daten sind möglicherweise beschädigt oder ein nicht unterstütztes Format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供されたデータからCGImageSourceを作成できませんでした。データが破損しているか、対応していないフォーマットの可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从提供的数据创建 CGImageSource。数据可能已损坏或格式不受支持。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar uma CGImageSource a partir dos dados fornecidos. Os dados podem estar corrompidos ou num formato não suportado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공된 데이터로부터 CGImageSource를 생성할 수 없습니다. 데이터가 손상되었거나 지원하지 않는 형식일 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare un CGImageSource dai dati forniti. I dati potrebbero essere corrotti o in un formato non supportato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen CGImageSource maken van de geleverde gegevens. De gegevens kunnen beschadigd zijn of een niet-ondersteund formaat hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć CGImageSource z dostarczonych danych. Dane mogą być uszkodzone lub w nieobsługiwanym formacie."
          }
        },
        "sv": {
          "stringUnit": {
