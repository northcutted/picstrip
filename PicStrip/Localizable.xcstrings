    "Addresses can reveal where someone lives, works, or spends time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Addresses can reveal where someone lives, works, or spends time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones pueden revelar dónde vive, trabaja o pasa tiempo alguien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses peuvent révéler où une personne habite, travaille ou passe du temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen können offenbaren, wo jemand wohnt, arbeitet oder Zeit verbringt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住所は、人がどこに住んでいるか、働いているか、または過ごしているかを明らかにすることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址可以透露某人居住、工作或消磨時間的地點。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços podem revelar onde alguém mora, trabalha ou passa o tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소는 누군가가 어디에 살고, 일하고, 시간을 보내는지 드러낼 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi possono rivelare dove una persona vive, lavora o trascorre il tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen kunnen onthullen waar iemand woont, werkt of tijd doorbrengt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy mogą ujawniać, gdzie ktoś mieszka, pracuje lub spędza czas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresser kan avslöja var någon bor, arbetar eller tillbringar tid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresler bir kişinin nerede yaşadığını, çalıştığını veya zaman geçirdiğini ortaya çıkarabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للعناوين الكشف عن مكان إقامة شخص ما أو عمله أو أين يقضي وقته."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地址可以揭露某人居住、工作或度過時間的地點。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços podem revelar onde alguém vive, trabalha ou passa tempo."
          }
        }
      }
    },
    "Aggregate counts only. PicStrip does not keep photo history, removed values, OCR snippets, or redaction boxes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo conteos agregados. PicStrip no guarda historial de fotos, valores eliminados, fragmentos OCR ni cuadros de censura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptage agrégé uniquement. PicStrip ne conserve pas l’historique des photos, les valeurs supprimées, les extraits OCR ou les zones de caviardage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur aggregierte Zählungen. PicStrip speichert keine Fotohistorie, entfernte Werte, OCR-Schnipsel oder Schwärzungsfelder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集計されたカウントのみを保持します。PicStripは写真の履歴、削除された値、OCRの抜粋、黒塗りボックスを保存しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计汇总计数。PicStrip 不会保存照片历史、已删除的数值、OCR摘录或遮挡框。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas contagens agregadas. PicStrip não mantém histórico de fotos, valores removidos, trechos de OCR ou caixas de redação."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집계된 개수만 저장합니다. PicStrip은 사진 기록, 제거된 값, OCR 스니펫 또는 수정 상자를 보관하지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo conteggi aggregati. PicStrip non conserva la cronologia delle foto, i valori rimossi, gli estratti OCR o le scatole di censura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geaggregeerde tellingen. PicStrip bewaart geen fotogeschiedenis, verwijderde waarden, OCR-fragmenten of redactievakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko zagregowane liczby. PicStrip nie przechowuje historii zdjęć, usuniętych wartości, fragmentów OCR ani pól do redakcji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast sammanställda räkningar. PicStrip sparar inte fotohistorik, borttagna värden, OCR-utdrag eller redigeringsrutor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca toplu sayımlar. PicStrip foto geçmişi, kaldırılan değerler, OCR parçaları veya sansür kutuları tutmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط العد الإجمالي. PicStrip لا يحتفظ بتاريخ الصور، القيم المحذوفة، مقتطفات OCR، أو صناديق التحرير."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅整體計數。PicStrip 不會保留照片歷史、已刪除的值、OCR 摘錄或遮蔽框。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagens agregadas apenas. PicStrip não mantém histórico de fotos, valores removidos, trechos de OCR ou caixas de redação."
          }
        }
      }
    },
