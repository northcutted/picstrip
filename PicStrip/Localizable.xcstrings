    "IP addresses can identify a network, workplace, approximate location, or infrastructure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "IP addresses can identify a network, workplace, approximate location, or infrastructure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones IP pueden identificar una red, lugar de trabajo, ubicación aproximada o infraestructura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses IP peuvent identifier un réseau, un lieu de travail, une localisation approximative ou une infrastructure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-Adressen können ein Netzwerk, einen Arbeitsplatz, einen ungefähren Standort oder eine Infrastruktur identifizieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPアドレスは、ネットワーク、職場、おおよその場所、またはインフラを特定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IP地址可以识别网络、工作场所、近似位置或基础设施。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços IP podem identificar uma rede, local de trabalho, localização aproximada ou infraestrutura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 주소는 네트워크, 직장, 대략적인 위치 또는 인프라를 식별할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi IP possono identificare una rete, un luogo di lavoro, una posizione approssimativa o un'infrastruttura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-adressen kunnen een netwerk, werkplek, geschatte locatie of infrastructuur identificeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy IP mogą identyfikować sieć, miejsce pracy, przybliżoną lokalizację lub infrastrukturę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-adresser kan identifiera ett nätverk, en arbetsplats, ungefärlig plats eller infrastruktur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IP adresleri bir ağı, iş yerini, yaklaşık konumu veya altyapıyı tanımlayabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناوين IP يمكن أن تحدد شبكة أو مكان عمل أو موقع تقريبية أو بنية تحتية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 位址可識別網路、工作場所、近似位置或基礎設施。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços IP podem identificar uma rede, local de trabalho, localização aproximada ou infraestrutura."
          }
        }
      }
    },
