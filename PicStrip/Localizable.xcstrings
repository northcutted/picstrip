    "A bleep replaces the sound with a tone; a mute silences it." : {
      "comment" : "Footer under the list of bleeps and mutes.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل الصفير الصوت بنغمة، ويكتمه الكتم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Piepton ersetzt den Ton durch ein Signal, Stumm schaltet ihn ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pitido sustituye el sonido por un tono; silenciar lo elimina."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pitido reemplaza el sonido por un tono; silenciar lo elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bip remplace le son par une tonalité ; couper le son le supprime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bip sostituisce l’audio con un tono; silenziare lo elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピー音は音声を信号音に置き換え、ミュートは音声を消します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삐 소리는 소리를 신호음으로 바꾸고, 음소거는 소리를 없앱니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
