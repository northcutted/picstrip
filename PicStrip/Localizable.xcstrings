    "Contextual information. Exposure risk depends on the recipient. Dates, URLs, barcodes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معلومات سياقية. تعتمد خطورة الكشف على المستلِم. التواريخ وعناوين URL والرموز الشريطية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontextinformationen. Wie riskant eine Offenlegung ist, hängt vom Empfänger ab. Datumsangaben, URLs, Barcodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Información contextual. El riesgo de exposición depende de quién la reciba. Fechas, URL, códigos de barras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informations contextuelles. Le risque d’exposition dépend du destinataire. Dates, URL, codes-barres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informazioni contestuali. Il rischio di esposizione dipende dal destinatario. Date, URL, codici a barre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文脈的な情報。共有する相手によってリスクは変わります。日付、URL、バーコードなど。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맥락 정보입니다. 노출 위험은 받는 사람에 따라 달라집니다. 날짜, URL, 바코드."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contextuele informatie. Het risico van blootstelling hangt af van de ontvanger. Datums, URL’s, barcodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informacje kontekstowe. Ryzyko ujawnienia zależy od odbiorcy. Daty, adresy URL, kody kreskowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informações de contexto. O risco da exposição depende de quem recebe. Datas, URLs, códigos de barras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informação contextual. O risco de exposição depende de quem a recebe. Datas, URLs e códigos de barras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontextuell information. Risken vid exponering beror på mottagaren. Datum, URL:er, streckkoder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlamsal bilgi. İfşa riski alıcıya bağlıdır. Tarihler, URL’ler, barkodlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文信息。泄露风险取决于接收方。日期、URL、条码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屬於情境資訊，外洩風險取決於接收者。日期、URL、條碼。"
          }
        }
      }
    },
    "Coordinates, altitude, speed, heading, and the exact timestamp your shutter fired" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإحداثيات والارتفاع والسرعة والاتجاه والطابع الزمني الدقيق للحظة التقاط الصورة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koordinaten, Höhe, Geschwindigkeit, Richtung und der genaue Zeitpunkt der Aufnahme"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordenadas, altitud, velocidad, rumbo y el momento exacto en que se disparó el obturador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordonnées, altitude, vitesse, cap et horodatage exact du déclenchement de l’obturateur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordinate, altitudine, velocità, direzione e l’istante esatto in cui è scattato l’otturatore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座標、高度、速度、進行方向、シャッターを切った正確な日時"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌표, 고도, 속도, 방향, 셔터가 눌린 정확한 시각"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coördinaten, hoogte, snelheid, richting en het exacte tijdstip waarop je sluiter afging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współrzędne, wysokość, prędkość, kierunek i dokładny moment zwolnienia migawki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordenadas, altitude, velocidade, direção e o instante exato em que o obturador disparou"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordenadas, altitude, velocidade, direção e o momento exato em que o obturador disparou"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koordinater, höjd, hastighet, riktning och den exakta tidpunkten då du tog bilden"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
