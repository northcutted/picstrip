    "No telemetry, no crash reporters, no ad SDKs. Your usage is not observed or collected in any way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد تتبعات، ولا مُبلّغات عن الأعطال، ولا SDK إعلانات. لا تتم مراقبة استخدامك أو جمعه بأي شكل من الأشكال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
