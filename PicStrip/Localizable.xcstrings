    "No telemetry, no crash reporters, no ad SDKs. Your usage is not observed or collected in any way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin telemetría, sin reportes de fallos, sin SDK de anuncios. No se observa ni recopila tu uso de ninguna forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de télémétrie, pas de rapports de plantage, pas de SDK publicitaires. Votre utilisation n'est ni observée ni collectée de quelque manière que ce soit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Telemetrie, keine Absturzberichte, keine Werbe-SDKs. Deine Nutzung wird in keiner Weise beobachtet oder gesammelt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレメトリなし、クラッシュレポートなし、広告SDKなし。利用状況は一切観察・収集されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无遥测,无崩溃报告,无广告SDK。您的使用情况不会被观察或收集。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem telemetria, sem relatórios de falhas, sem SDKs de anúncios. Seu uso não é observado nem coletado de forma alguma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텔레메트리, 충돌 보고, 광고 SDK가 없습니다. 사용 내역이 관찰되거나 수집되지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna telemetria, nessun report di crash, nessun SDK pubblicitario. L'uso non è osservato né raccolto in alcun modo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen telemetrie, geen crashrapporten, geen advertentie-SDK's. Je gebruik wordt op geen enkele manier geobserveerd of verzameld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak telemetrii, brak raportów o awariach, brak SDK reklam. Twoje korzystanie nie jest w żaden sposób obserwowane ani zbierane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen telemetri, inga krastrapporter, inga annons-SDK:er. Din användning observeras eller samlas in på inget sätt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telemetri yok, çökme raporu yok, reklam SDK'sı yok. Kullanımınız hiçbir şekilde gözlemlenmez veya toplanmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تتبعات، ولا مُبلّغات عن الأعطال، ولا SDK إعلانات. لا تتم مراقبة استخدامك أو جمعه بأي شكل من الأشكال."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無遙測、無崩潰報告、無廣告 SDK。您的使用情況不會以任何方式被觀察或收集。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem telemetria, sem relatórios de falhas, sem SDKs de anúncios. A sua utilização não é observada nem recolhida de forma alguma."
          }
        }
      }
    },
