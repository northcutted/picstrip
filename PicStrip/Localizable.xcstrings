    "Custom redactions hide sensitive visual details that automatic detection may not understand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Custom redactions hide sensitive visual details that automatic detection may not understand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las redacciones personalizadas ocultan detalles sensibles visuales que la detección automática puede no reconocer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les masques personnalisés cachent des détails visuels sensibles que la détection automatique peut ne pas reconnaître."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Schwärzungen verbergen sensible visuelle Details, die die automatische Erkennung möglicherweise nicht versteht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム黒塗りは、自動検出が認識しきれない機微な視覚的詳細を隠します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义遮掩可隐藏自动检测可能无法识别的敏感视觉细节。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras personalizadas ocultam detalhes visuais sensíveis que a detecção automática pode não entender."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞춤 편집은 자동 감지가 이해하지 못할 수 있는 민감한 시각적 세부 정보를 숨깁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le oscurature personalizzate nascondono dettagli visivi sensibili che il rilevamento automatico potrebbe non comprendere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste weergaven verbergen gevoelige visuele details die automatische detectie mogelijk niet herkent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe zaciemnienia ukrywają wrażliwe szczegóły wizualne, których automatyczne wykrywanie może nie rozpoznać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade markeringar döljer känsliga visuella detaljer som automatisk detektion kanske inte förstår."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel sansürler, otomatik algılamanın anlayamayabileceği hassas görsel detayları gizler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخفي التعتيمات المخصصة تفاصيل بصرية حساسة قد لا تفهمها الكشف التلقائي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义蒙版隐藏自动检测可能无法理解的敏感视觉细节。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscaras personalizadas ocultam detalhes visuais sensíveis que a deteção automática pode não compreender."
          }
        }
      }
    },
