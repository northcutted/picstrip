    "High efficiency. Apple OS may inject Maker data upon saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كفاءة عالية. قد يضيف نظام Apple بيانات الصانع عند الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Effizienz. Apple OS kann beim Speichern Herstellerdaten einfügen."
