    "Significant personal, financial, or identity harm. Bank account numbers, faces, physical credentials written on paper." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضرر كبير على المستوى الشخصي أو المالي أو المتعلق بالهوية. أرقام الحسابات المصرفية، والوجوه، وبيانات الاعتماد المكتوبة على الورق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erheblicher persönlicher, finanzieller oder identitätsbezogener Schaden. Bankkontonummern, Gesichter, auf Papier notierte Anmeldedaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daño personal, financiero o de identidad considerable. Números de cuenta bancaria, caras y credenciales escritas en papel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préjudice important pour votre personne, vos finances ou votre identité. Numéros de compte bancaire, visages, identifiants notés sur papier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danno significativo a livello personale, finanziario o di identità. Numeri di conto bancario, volti, credenziali scritte su carta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人・金銭・身元への大きな被害。銀行口座番号、顔、紙に書かれた認証情報など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인, 금융, 신분에 큰 피해를 줄 수 있습니다. 은행 계좌 번호, 얼굴, 종이에 적힌 자격 증명."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanzienlijke schade voor je persoon, financiën of identiteit. Bankrekeningnummers, gezichten, inloggegevens op papier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poważne szkody osobiste, finansowe lub związane z tożsamością. Numery rachunków bankowych, twarze, dane dostępowe zapisane na papierze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dano pessoal, financeiro ou de identidade significativo. Números de conta bancária, rostos, credenciais físicas escritas no papel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danos significativos a nível pessoal, financeiro ou de identidade. Números de conta bancária, rostos e credenciais escritas em papel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betydande skada för dig personligen, för din ekonomi eller för din identitet. Bankkontonummer, ansikten, fysiska inloggningsuppgifter skrivna på papper."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciddi kişisel, mali veya kimlik zararı. Banka hesap numaraları, yüzler, kâğıda yazılmış fiziksel kimlik bilgileri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能造成重大的个人、财务或身份损害。银行账号、人脸、写在纸上的实体凭证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能造成重大的個人、財務或身分傷害。銀行帳號、人臉、寫在紙上的實體憑證。"
          }
        }
      }
    },
