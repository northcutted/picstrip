          "stringUnit" : {
            "state" : "translated",
            "value" : "الثقة تلخص فقط الاكتشافات البصرية التلقائية. يتم احتساب التظليلات المخصصة بدون درجة ثقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuverlässigkeit fasst nur automatische visuelle Erkennungen zusammen. Benutzerdefinierte Schwärzungen werden ohne Zuverlässigkeitswert gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confianza resume solo las detecciones visuales automáticas. Las censuras personalizadas se cuentan sin puntaje de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confiance résume uniquement les détections visuelles automatiques. Les occultations personnalisées sont comptées sans score de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fiducia riassume solo le rilevazioni visive automatiche. Le oscurazioni personalizzate sono conteggiate senza un punteggio di fiducia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼度は自動視覚検出のみを要約します。カスタム編集は信頼度スコアなしでカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰도는 자동 시각 감지 결과만 요약합니다. 사용자 맞춤 검정은 신뢰도 점수 없이 계산됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouwen vat alleen automatische visuele detecties samen. Aangepaste redacties worden geteld zonder vertrouwensscore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pewność dotyczy tylko automatycznych wykryć wizualnych. Własne zaciemnienia są liczone bez wartości pewności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A confiança resume apenas as detecções visuais automáticas. Ocultações personalizadas são contadas sem uma pontuação de confiança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A confiança resume apenas as deteções visuais automáticas. As edições personalizadas são contadas sem pontuação de confiança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förtroende sammanfattar endast automatiska visuella detektioner. Anpassade redigeringar räknas utan förtroendescore."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güven, yalnızca otomatik görsel tespitleri özetler. Özel sansürler güven puanı olmadan sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置信度仅总结自动视觉检测。自定义遮盖不计算置信度分数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信心值僅總結自動視覺偵測。自訂遮蔽則未計入信心分數。"
          }
        }
      }
    },
