    "Privacy metadata is stripped automatically before saving.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos de privacidad se eliminan automáticamente antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de confidentialité sont supprimées automatiquement avant l'enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz-Metadaten werden vor dem Speichern automatisch entfernt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前にプライバシーメタデータは自動的に削除されます。"
