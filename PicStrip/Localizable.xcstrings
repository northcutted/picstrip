    "The camera is running warm. Recording may drop to 30 fps while it cools." : {
      "comment" : "Status note when the phone gets hot; fps = frames per second (keep “fps” or use your language's usual abbreviation).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرارة الكاميرا مرتفعة. قد ينخفض التسجيل إلى 30 إطارًا في الثانية حتى تبرد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera ist warm. Während sie abkühlt, kann die Aufnahme auf 30 fps sinken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se está calentando. La grabación puede bajar a 30 fps mientras se enfría."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se está calentando. La grabación puede bajar a 30 fps mientras se enfría."
          }
        },
        "fr" : {
          "stringUnit" : {
