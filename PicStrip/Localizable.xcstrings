    "Edit opens the first original image for review. A protected local copy expires after 15 minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح التحرير أول صورة أصلية للمراجعة. تنتهي صلاحية النسخة المحلية المحمية بعد 15 دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten öffnet das erste Originalbild zur Prüfung. Eine geschützte lokale Kopie läuft nach 15 Minuten ab."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre la primera imagen original para revisarla. Una copia local protegida caduca a los 15 minutos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre la primera imagen original para revisarla. Una copia local protegida caduca a los 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier ouvre la première image originale pour vérification. Une copie locale protégée expire après 15 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica apre la prima immagine originale per il controllo. Una copia locale protetta scade dopo 15 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集では最初の元画像を開いて確認します。保護されたローカルコピーの有効期限は15分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집은 첫 번째 원본 이미지를 열어 검토합니다. 보호된 로컬 사본은 15분 후 만료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerken opent de eerste originele afbeelding ter controle. Een beveiligde lokale kopie verloopt na 15 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edycja otwiera pierwszy oryginalny obraz do sprawdzenia. Chroniona kopia lokalna wygasa po 15 minutach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre a primeira imagem original para revisão. Uma cópia local protegida expira após 15 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre a primeira imagem original para revisão. Uma cópia local protegida expira após 15 minutos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigera öppnar den första originalbilden för granskning. En skyddad lokal kopia upphör att gälla efter 15 minuter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle, incelemek için ilk özgün görüntüyü açar. Korumalı yerel kopyanın süresi 15 dakika sonra dolar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“编辑”会打开第一张原始图像以供检查。受保护的本地副本将在15分钟后过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編輯」會開啟第一張原始影像以供檢查。受保護的本機拷貝將在15分鐘後到期。"
          }
        }
      }
    },
    "Edit opens the first video in PicStrip, where you can cover faces and text. A protected local copy expires after 15 minutes." : {
      "comment" : "Share sheet caption under the “Edit in PicStrip” button when the first shared item is a video.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح التحرير أول فيديو في PicStrip، حيث يمكنك حجب الوجوه والنصوص. تنتهي صلاحية النسخة المحلية المحمية بعد 15 دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten öffnet das erste Video in PicStrip, wo du Gesichter und Text verdecken kannst. Eine geschützte lokale Kopie läuft nach 15 Minuten ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre el primer vídeo en PicStrip, donde puedes censurar caras y texto. Una copia local protegida caduca a los 15 minutos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre el primer video en PicStrip, donde puedes censurar caras y texto. Una copia local protegida caduca a los 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier ouvre la première vidéo dans PicStrip, où vous pouvez masquer les visages et le texte. Une copie locale protégée expire après 15 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica apre il primo video in PicStrip, dove puoi coprire volti e testo. Una copia locale protetta scade dopo 15 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集では最初のビデオをPicStripで開き、顔や文字をマスクできます。保護されたローカルコピーの有効期限は15分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집을 탭하면 첫 번째 비디오가 PicStrip에서 열리며, 여기서 얼굴과 텍스트를 가릴 수 있습니다. 보호된 로컬 사본은 15분 후 만료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerken opent de eerste video in PicStrip, waar je gezichten en tekst kunt afdekken. Een beveiligde lokale kopie verloopt na 15 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edycja otwiera pierwsze wideo w PicStrip, gdzie możesz zamazać twarze i tekst. Chroniona kopia lokalna wygasa po 15 minutach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre o primeiro vídeo no PicStrip, onde você pode ocultar rostos e textos. Uma cópia local protegida expira após 15 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar abre o primeiro vídeo no PicStrip, onde pode ocultar rostos e texto. Uma cópia local protegida expira após 15 minutos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigera öppnar den första videon i PicStrip, där du kan maskera ansikten och text. En skyddad lokal kopia upphör att gälla efter 15 minuter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle, ilk videoyu PicStrip’te açar; burada yüzleri ve metinleri karartabilirsiniz. Korumalı yerel kopyanın süresi 15 dakika sonra dolar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“编辑”会在 PicStrip 中打开第一个视频，你可以在其中遮盖面孔和文字。受保护的本地副本将在15分钟后过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編輯」會在 PicStrip 中打開第一部影片，你可以在其中遮蓋臉孔和文字。受保護的本機拷貝將在15分鐘後到期。"
          }
        }
      }
    },
