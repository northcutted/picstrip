    "The original photo could not be identified. It may be stored in iCloud and not yet downloaded. Would you like to save as a new photo instead?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo identificar la foto original. Puede estar almacenada en iCloud y no descargada aún. ¿Quieres guardarla como una foto nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo originale n’a pas pu être identifiée. Elle pourrait être stockée dans iCloud et pas encore téléchargée. Souhaitez-vous enregistrer une nouvelle photo à la place ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Originalfoto konnte nicht identifiziert werden. Es könnte in iCloud gespeichert und noch nicht heruntergeladen sein. Möchten Sie stattdessen ein neues Foto speichern?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真を特定できませんでした。iCloudに保存されていてまだダウンロードされていない可能性があります。代わりに新しい写真として保存しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别原始照片。它可能存储在 iCloud 中尚未下载。您想改为保存为新照片吗?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto original não pôde ser identificada. Pode estar armazenada no iCloud e ainda não ter sido baixada. Gostaria de salvar como uma nova foto em vez disso?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 사진을 식별할 수 없습니다. iCloud에 저장되어 있고 아직 다운로드하지 않았을 수 있습니다. 대신 새 사진으로 저장하시겠습니까?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto originale non è stata identificata. Potrebbe essere archiviata su iCloud e non ancora scaricata. Vuoi salvarla come nuova foto invece?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De originele foto kon niet worden geïdentificeerd. Mogelijk is deze opgeslagen in iCloud en nog niet gedownload. Wilt u deze in plaats daarvan opslaan als een nieuwe foto?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zidentyfikować oryginalnego zdjęcia. Może być przechowywane w iCloud i jeszcze nie zostało pobrane. Czy chcesz zapisać je jako nowe zdjęcie?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ursprungliga fotot kunde inte identifieras. Det kan finnas lagrat i iCloud och inte laddats ner än. Vill du spara det som ett nytt foto istället?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal foto tanımlanamadı. iCloud'da depolanmış ve henüz indirilmeyecek olabilir. Bunun yerine yeni bir fotoğraf olarak kaydetmek ister misiniz?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمكن تحديد الصورة الأصلية. قد تكون مخزنة في iCloud ولم تُحمّل بعد. هل ترغب في حفظها كصورة جديدة بدلاً من ذلك؟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別原始照片。它可能存儲在 iCloud 中,尚未下載。您是否想改為將其保存為新照片?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto original não pôde ser identificada. Pode estar armazenada no iCloud e ainda não ter sido descarregada. Gostaria de guardar como uma nova foto em vez disso?"
          }
        }
      }
    },
    "The original photos will be permanently deleted after cleaning. This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos originales se eliminarán permanentemente después de la limpieza. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos originales seront définitivement supprimées après le nettoyage. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalfotos werden nach der Bereinigung dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーニング後、オリジナルの写真は完全に削除されます。元に戻すことはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理后,原始照片将被永久删除,此操作无法撤销。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos originais serão excluídas permanentemente após a limpeza. Isto não pode ser desfeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 사진은 정리 후 영구 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto originali verranno eliminate definitivamente dopo la pulizia. Questa operazione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De originele foto’s worden na het opschonen permanent verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalne zdjęcia zostaną trwale usunięte po oczyszczeniu. Nie można tego cofnąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De ursprungliga fotona kommer att raderas permanent efter rensningen. Detta kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal fotoğraflar temizleme işleminden sonra kalıcı olarak silinecektir. Bu işlem geri alınamaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الصور الأصلية بشكل دائم بعد التنظيف. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理後,原始照片將被永久刪除,無法復原。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos originais serão eliminadas permanentemente após a limpeza. Isto não pode ser desfeito."
          }
        }
      }
    },
    "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación exacta donde se tomó esta foto — latitud, longitud y altitud. Compartirla revela dónde vives, trabajas o viajas, y puede usarse para rastrear tus movimientos con el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement précis où cette photo a été prise — latitude, longitude et altitude. Le partager révèle où vous vivez, travaillez ou voyagez, et peut permettre de suivre vos déplacements au fil du temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der genaue Ort, an dem dieses Foto aufgenommen wurde – Breite, Länge und Höhe. Das Teilen zeigt, wo Sie leben, arbeiten oder reisen, und kann verwendet werden, um Ihre Bewegungen im Laufe der Zeit zu verfolgen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真が撮影された正確な位置情報(緯度、経度、高度)。共有すると、あなたがどこに住み、働き、旅行しているかを明らかにし、時間をかけて行動を追跡される可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片拍摄的精确位置 — 纬度、经度和高度。分享这些信息会暴露您的住所、工作地点或旅行路线,并可能被用于追踪您的移动轨迹。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização precisa onde esta foto foi tirada — latitude, longitude e altitude. Compartilhá-la revela onde você mora, trabalha ou viaja, e pode ser usada para rastrear seus movimentos ao longo do tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진이 찍힌 정확한 위치 — 위도, 경도, 고도. 공유하면 거주지, 근무지 또는 여행지 위치가 드러나며, 시간이 지남에 따라 이동 경로 추적에 사용될 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione precisa in cui è stata scattata questa foto — latitudine, longitudine e altitudine. Condividerla rivela dove vivi, lavori o viaggi e può essere usata per tracciare i tuoi spostamenti nel tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De exacte locatie waar deze foto is genomen — breedtegraad, lengtegraad en hoogte. Delen betekent dat zichtbaar wordt waar je woont, werkt of reist, en kan worden gebruikt om je bewegingen in de tijd te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładna lokalizacja wykonania tego zdjęcia – szerokość i długość geograficzna oraz wysokość. Udostępnienie tych danych ujawnia miejsce, gdzie mieszkasz, pracujesz lub podróżujesz, i może być użyte do śledzenia twoich ruchów w czasie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den exakta plats där detta foto togs – latitud, longitud och altitud. Att dela det avslöjar var du bor, arbetar eller reser, och kan användas för att spåra dina rörelser över tid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğrafın çekildiği tam konum – enlem, boylam ve yükseklik. Paylaşmak, nerede yaşadığınızı, çalıştığınızı veya seyahat ettiğinizi ortaya çıkarır ve zaman içinde hareketlerinizi takip etmek için kullanılabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع الدقيق الذي تم التقاط هذه الصورة فيه – خط العرض وخط الطول والارتفاع. مشاركته يكشف المكان الذي تعيش أو تعمل أو تسافر إليه، ويمكن استخدامه لتتبع تحركاتك مع مرور الوقت."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝此照片的精確位置——緯度、經度和高度。分享它會透露您居住、工作或旅行的地點,並可用於追蹤您隨時間的移動軌跡。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização precisa onde esta foto foi tirada — latitude, longitude e altitude. Partilhá-la revela onde vive, trabalha ou viaja, e pode ser usada para rastrear os seus movimentos ao longo do tempo."
          }
        }
      }
    },
    "The selected item could not be loaded as image data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The selected item could not be loaded as image data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el elemento seleccionado como datos de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elément sélectionné impossible à charger en tant que données d’image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Element konnte nicht als Bilddaten geladen werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目は画像データとして読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载所选项目作为图像数据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item selecionado não pôde ser carregado como dados de imagem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 이미지 데이터로 불러올 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elemento selezionato non può essere caricato come dati immagine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde item kon niet worden geladen als afbeeldingsgegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można załadować wybranego elementu jako danych obrazu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valda objektet kunde inte läsas in som bilddata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen öğe resim verisi olarak yüklenemedi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر تحميل العنصر المحدد كبيانات صورة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選取的項目無法載入為影像資料。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O item selecionado não pôde ser carregado como dados de imagem."
          }
        }
      }
    },
    "The source image format is not supported for re-encoding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source image format is not supported for re-encoding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de imagen fuente no es compatible para re-codificación."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak resim formatı yeniden kodlama için desteklenmiyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق صورة المصدر غير مدعوم لإعادة الترميز."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源圖像格式不支援重新編碼。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato da imagem de origem não é suportado para reencodificação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de l’image source n’est pas pris en charge pour la réencodage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Quellbildformat wird für die Neukodierung nicht unterstützt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再エンコードするためのソース画像フォーマットはサポートされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持对源图像格式进行重新编码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
