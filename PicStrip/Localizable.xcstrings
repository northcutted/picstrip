    "Confidence summarizes automatic visual detections only. Custom redactions are counted without a confidence score.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confianza resume solo las detecciones visuales automáticas. Las censuras personalizadas se cuentan sin puntaje de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confiance résume uniquement les détections visuelles automatiques. Les occultations personnalisées sont comptées sans score de confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zuverlässigkeit fasst nur automatische visuelle Erkennungen zusammen. Benutzerdefinierte Schwärzungen werden ohne Zuverlässigkeitswert gezählt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼度は自動視覚検出のみを要約します。カスタム編集は信頼度スコアなしでカウントされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置信度仅总结自动视觉检测。自定义遮盖不计算置信度分数。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A confiança resume apenas as detecções visuais automáticas. Ocultações personalizadas são contadas sem uma pontuação de confiança."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰도는 자동 시각 감지 결과만 요약합니다. 사용자 맞춤 검정은 신뢰도 점수 없이 계산됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiducia riassume solo le rilevazioni visive automatiche. Le oscurazioni personalizzate sono conteggiate senza un punteggio di fiducia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrouwen vat alleen automatische visuele detecties samen. Aangepaste redacties worden geteld zonder vertrouwensscore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pewność dotyczy tylko automatycznych wykryć wizualnych. Własne zaciemnienia są liczone bez wartości pewności."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förtroende sammanfattar endast automatiska visuella detektioner. Anpassade redigeringar räknas utan förtroendescore."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven, yalnızca otomatik görsel tespitleri özetler. Özel sansürler güven puanı olmadan sayılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثقة تلخص فقط الاكتشافات البصرية التلقائية. يتم احتساب التظليلات المخصصة بدون درجة ثقة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信心值僅總結自動視覺偵測。自訂遮蔽則未計入信心分數。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A confiança resume apenas as deteções visuais automáticas. As edições personalizadas são contadas sem pontuação de confiança."
          }
        }
      }
    },
    "Coordinates, altitude, speed, heading, and the exact timestamp your shutter fired": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas, altitud, velocidad, rumbo y la marca de tiempo exacta en que disparó tu obturador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnées, altitude, vitesse, cap et horodatage exact du déclenchement de votre obturateur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinaten, Höhe, Geschwindigkeit, Kurs und der genaue Zeitstempel, zu dem dein Auslöser ausgelöst hat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座標、高度、速度、方位角、およびシャッターが切られた正確なタイムスタンプ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐标、海拔、速度、航向和快门触发的精确时间戳"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas, altitude, velocidade, rumo e o carimbo de data/hora exato em que sua obturador disparou"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셔터가 눌린 정확한 타임스탬프와 함께 좌표, 고도, 속도, 진행 방향"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinate, altitudine, velocità, direzione e timestamp esatto dello scatto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coördinaten, hoogte, snelheid, koers en het exacte tijdstip waarop je sluiter afging"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Współrzędne, wysokość, prędkość, kierunek i dokładny znacznik czasu wyzwolenia migawki"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinater, höjd, hastighet, kurs och den exakta tidpunkten då din slutare utlöstes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarasyon, irtifa, hız, yön ve deklanşörünüzün tam zaman damgası"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإحداثيات والارتفاع والسرعة والاتجاه والطابع الزمني الدقيق لنقرة الغالق الخاصة بك"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "座標、高度、速度、航向以及快門釋放的精確時間戳"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas, altitude, velocidade, rumo e a marca temporal exata em que o obturador disparou"
          }
        }
      }
    },
    "Could not create a CGImageDestination for the requested output format.": {
      "localizations": {
