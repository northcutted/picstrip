        }
      }
    },
    "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع الدقيق الذي تم التقاط هذه الصورة فيه — خط العرض وخط الطول والارتفاع. مشاركته تكشف المكان الذي تعيش فيه أو تعمل فيه أو تسافر إليه، ويمكن استخدامه لتتبع تحركاتك بمرور الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der genaue Ort, an dem dieses Foto aufgenommen wurde – Breitengrad, Längengrad und Höhe. Wenn du ihn teilst, verrät er, wo du wohnst, arbeitest oder unterwegs bist, und er lässt sich nutzen, um deine Bewegungen über die Zeit zu verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación exacta donde se tomó esta foto — latitud, longitud y altitud. Compartirla revela dónde vives, trabajas o viajas, y puede usarse para rastrear tus movimientos con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emplacement précis où cette photo a été prise — latitude, longitude et altitude. Le partager révèle où vous vivez, travaillez ou voyagez, et peut permettre de suivre vos déplacements au fil du temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione precisa in cui è stata scattata questa foto — latitudine, longitudine e altitudine. Condividerla rivela dove vivi, lavori o viaggi e può essere usata per tracciare i tuoi spostamenti nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真が撮影された正確な位置情報（緯度、経度、高度）。共有すると、住んでいる場所、働いている場所、旅行先が明らかになり、長期的な行動の追跡に使われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진이 찍힌 정확한 위치 — 위도, 경도, 고도. 공유하면 거주지, 근무지 또는 여행지 위치가 드러나며, 시간이 지남에 따라 이동 경로 추적에 사용될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De exacte locatie waar deze foto is genomen — breedtegraad, lengtegraad en hoogte. Delen betekent dat zichtbaar wordt waar je woont, werkt of reist, en kan worden gebruikt om je bewegingen in de tijd te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna lokalizacja wykonania tego zdjęcia – szerokość i długość geograficzna oraz wysokość. Udostępnienie tych danych ujawnia miejsce, gdzie mieszkasz, pracujesz lub podróżujesz, i może posłużyć do śledzenia Twoich ruchów w czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização precisa onde esta foto foi tirada — latitude, longitude e altitude. Compartilhá-la revela onde você mora, trabalha ou viaja, e pode ser usada para rastrear seus movimentos ao longo do tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização precisa onde esta fotografia foi tirada — latitude, longitude e altitude. Partilhá-la revela onde vive, trabalha ou viaja e pode ser usada para rastrear os seus movimentos ao longo do tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den exakta platsen där bilden togs – latitud, longitud och höjd. Om du delar den avslöjar du var du bor, arbetar eller reser, och uppgifterna kan användas för att spåra dina rörelser över tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fotoğrafın çekildiği tam konum — enlem, boylam ve yükseklik. Paylaşmak, nerede yaşadığınızı, çalıştığınızı veya seyahat ettiğinizi ortaya çıkarır ve zaman içinde hareketlerinizi takip etmek için kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄这张照片的精确位置——纬度、经度和海拔。共享这些信息会暴露你的居住地、工作地点或行程，并可能被用来追踪你的活动轨迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝這張照片的確切位置——緯度、經度和高度。分享出去會透露你居住、工作或旅行的地點，也可能被用來追蹤你的行蹤。"
          }
        }
      }
    },
