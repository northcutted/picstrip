        }
      }
    },
    "The object selection model could not be downloaded. You can still drag to draw a box." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل نموذج تحديد الكائنات. لا يزال بإمكانك السحب لرسم مربع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
