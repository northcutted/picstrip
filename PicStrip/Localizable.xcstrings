    "Phone numbers can be searched, messaged, or linked to public records and account recovery flows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن البحث عن أرقام الهواتف، أو إرسال رسائل إليها، أو ربطها بالسجلات العامة وسير استعادة الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonnummer können gesucht, angeschrieben oder mit öffentlichen Aufzeichnungen und Kontowiederherstellungsabläufen verknüpft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Phone numbers can be searched, messaged, or linked to public records and account recovery flows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de teléfono pueden ser buscados, contactados o vinculados a registros públicos y flujos de recuperación de cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de téléphone peuvent être recherchés, contactés par message, ou associés à des registres publics et des processus de récupération de compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri di telefono possono essere cercati, messaggiati o collegati a registri pubblici e procedure di recupero account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話番号は検索、メッセージ送信、または公的記録やアカウント回復のフローに関連付けることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화번호는 검색, 메시지 발송, 공개 기록 및 계정 복구 절차에 연결될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefoonnummers kunnen worden gezocht, bericht gestuurd of gekoppeld aan openbare registers en accountherstelflows."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numery telefonów mogą być wyszukiwane, otrzymywać wiadomości lub są powiązane z rejestrami publicznymi oraz procesami odzyskiwania konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Números de telefone podem ser pesquisados, enviados mensagens ou vinculados a registros públicos e fluxos de recuperação de conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números de telefone podem ser pesquisados, mensageados ou ligados a registos públicos e fluxos de recuperação de conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonnummer kan sökas, meddelas eller länkas till offentliga register och kontåterställningsflöden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon numaraları aranabilir, mesaj gönderilebilir veya kamu kayıtları ve hesap kurtarma süreçlerine bağlanabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电话号码可以被搜索、发送消息,或链接到公共记录和账户恢复流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話號碼可以被搜尋、發送訊息,或連結到公開紀錄和帳戶恢復流程。"
          }
        }
      }
    },
    "Photo library access was denied. Please enable it in Settings." : {
