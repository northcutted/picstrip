    "Links can expose private documents, usernames, tracking parameters, or internal systems.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Links can expose private documents, usernames, tracking parameters, or internal systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces pueden exponer documentos privados, nombres de usuario, parámetros de rastreo o sistemas internos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens peuvent divulguer des documents privés, des noms d’utilisateur, des paramètres de suivi ou des systèmes internes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links können private Dokumente, Benutzernamen, Tracking-Parameter oder interne Systeme offenlegen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、プライベートなドキュメント、ユーザー名、トラッキングパラメータ、または内部システムを公開する可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可能会暴露私人文件、用户名、跟踪参数或内部系统。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links podem expor documentos privados, nomes de usuário, parâmetros de rastreamento ou sistemas internos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 개인 문서, 사용자 이름, 추적 매개변수 또는 내부 시스템을 노출할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link possono esporre documenti privati, nomi utente, parametri di tracciamento o sistemi interni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links kunnen privé documenten, gebruikersnamen, trackingparameters of interne systemen blootstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki mogą ujawniać prywatne dokumenty, nazwy użytkowników, parametry śledzenia lub systemy wewnętrzne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar kan exponera privata dokument, användarnamn, spårningsparametrar eller interna system."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılar özel belgeleri, kullanıcı adlarını, izleme parametrelerini veya dahili sistemleri açığa çıkarabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن تكشف الروابط عن مستندات خاصة، وأسماء مستخدمين، ومعلمات تتبع، أو أنظمة داخلية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結可能會暴露私人文件、使用者名稱、追蹤參數或內部系統。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Links podem expor documentos privados, nomes de utilizador, parâmetros de rastreio ou sistemas internos."
          }
        }
      }
    },
