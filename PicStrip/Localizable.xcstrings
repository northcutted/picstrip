    "Could not create a CGImageSource from the supplied data. The data may be corrupt or an unsupported format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنشاء CGImageSource من البيانات المقدمة. قد تكون البيانات تالفة أو بتنسيق غير مدعوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus den bereitgestellten Daten konnte kein CGImageSource erstellt werden. Die Daten sind möglicherweise beschädigt oder liegen in einem nicht unterstützten Format vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create a CGImageSource from the supplied data. The data may be corrupt or an unsupported format."
