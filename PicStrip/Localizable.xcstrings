    "Save the cleaned photo back to your library or replace the original. An audit report is always available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بحفظ الصورة المُنظّفة مرة أخرى إلى مكتبتك أو استبدل الأصلية. تقرير تدقيق متاح دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie das bereinigte Foto zurück in Ihrer Bibliothek oder ersetzen Sie das Original. Ein Prüfbericht ist stets verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la foto limpiada de nuevo en tu biblioteca o reemplaza el original. Siempre se dispone de un informe de auditoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la photo nettoyée dans votre bibliothèque ou remplacez l’original. Un rapport d’audit est toujours disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva la foto pulita nella tua libreria o sostituisci l’originale. Un rapporto di audit è sempre disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップした写真をライブラリに保存するか、元の写真を置き換えます。監査報告書は常に利用可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리된 사진을 라이브러리에 저장하거나 원본을 교체하세요. 감사 보고서는 항상 이용 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla de schoongemaakte foto op in je bibliotheek of vervang het origineel. Een auditrapport is altijd beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz wyczyszczone zdjęcie w swojej bibliotece lub zastąp oryginał. Raport audytu jest zawsze dostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve a foto limpa de volta para sua biblioteca ou substitua o original. Um relatório de auditoria está sempre disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde a foto limpa de volta na sua biblioteca ou substitua o original. Um relatório de auditoria está sempre disponível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara tillbaka det rengjorda fotot till ditt bibliotek eller ersätt originalet. En revisionsrapport finns alltid tillgänglig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temizlenen fotoğrafı kütüphanenize kaydedin veya orijinalini değiştirin. Denetim raporu her zaman mevcuttur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
