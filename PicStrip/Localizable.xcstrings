    "Addresses can reveal where someone lives, works, or spends time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للعناوين الكشف عن مكان إقامة شخص ما أو عمله أو أين يقضي وقته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
