    "IP addresses can identify a network, workplace, approximate location, or infrastructure." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين IP يمكن أن تحدد شبكة أو مكان عمل أو موقع تقريبية أو بنية تحتية."
          }
        },
        "de" : {
          "stringUnit" : {
