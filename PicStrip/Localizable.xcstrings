    "Low-level image properties including software version, color profile, and copyright strings — which sometimes contain your real name or organisation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خصائص الصور منخفضة المستوى التي تتضمن إصدار البرنامج وملف الألوان وسلاسل حقوق الطبع والنشر — والتي تحتوي أحيانًا على اسمك الحقيقي أو المؤسسة الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild-Eigenschaften auf niedriger Ebene, einschließlich Softwareversion, Farbprofil und Copyright-Informationen — die manchmal Ihren echten Namen oder Ihre Organisation enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Low-level image properties including software version, color profile, and copyright strings — which sometimes contain your real name or organisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propiedades de imagen de bajo nivel que incluyen versión de software, perfil de color y cadenas de copyright — que a veces contienen tu nombre real u organización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriétés d’image de bas niveau incluant la version du logiciel, le profil colorimétrique et les chaînes de copyright — qui contiennent parfois votre vrai nom ou votre organisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proprietà dell’immagine a basso livello, incluse versione software, profilo colore e stringhe di copyright — che talvolta possono contenere il tuo vero nome o l’organizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトウェアバージョン、カラープロファイル、著作権表記など、時に実名や所属組織を含む低レベルな画像プロパティ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소프트웨어 버전, 색상 프로필, 저작권 문자열 등 때때로 사용자의 실제 이름이나 조직이 포함된 저수준 이미지 속성입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laag-niveau afbeeldingeigenschappen inclusief softwareversie, kleurprofiel en copyrightteksten — die soms uw echte naam of organisatie bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niskopoziomowe właściwości obrazu, w tym wersja oprogramowania, profil kolorów i ciągi znaków z prawami autorskimi — które czasami zawierają Twoje prawdziwe imię lub nazwę organizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriedades de imagem em baixo nível, incluindo versão do software, perfil de cor e strings de direitos autorais — que por vezes contêm o seu nome real ou organização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriedades de imagem de baixo nível incluindo versão do software, perfil de cor e cadeias de direitos de autor — que por vezes contêm o seu nome real ou organização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lågupplösta bildegenskaper inklusive programvaruversion, färgprofil och upphovsrättssträngar — som ibland innehåller ditt riktiga namn eller organisation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazılım sürümü, renk profili ve bazen gerçek isminizi veya kuruluşunuzu içeren telif hakkı dizeleri dahil düşük düzeyde resim özellikleri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括软件版本、色彩配置文件及版权字符串的低级图像属性——有时包含您的真实姓名或组织。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括軟體版本、色彩設定檔及版權字串等低階影像屬性,這些字串有時可能包含您的真實姓名或組織名稱。"
          }
        }
      }
    },
