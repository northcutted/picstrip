    "Secrets and tokens can grant access to accounts, code, infrastructure, or paid services." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للأسرار والرموز أن تمنح حق الوصول إلى الحسابات أو الشيفرة أو البنية التحتية أو الخدمات المدفوعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse und Tokens können Zugang zu Konten, Code, Infrastruktur oder kostenpflichtigen Diensten gewähren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Secrets and tokens can grant access to accounts, code, infrastructure, or paid services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los secretos y tokens pueden otorgar acceso a cuentas, código, infraestructura o servicios pagos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les secrets et les jetons peuvent donner accès à des comptes, du code, des infrastructures ou des services payants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segreti e token possono concedere accesso ad account, codice, infrastruttura o servizi a pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットやトークンは、アカウント、コード、インフラストラクチャ、または有料サービスへのアクセス権を付与することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 및 토큰은 계정, 코드, 인프라 또는 유료 서비스에 대한 액세스 권한을 부여할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimen en tokens kunnen toegang verlenen tot accounts, code, infrastructuur of betaalde diensten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekrety i tokeny mogą zapewnić dostęp do kont, kodu, infrastruktury lub płatnych usług."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segredos e tokens podem conceder acesso a contas, código, infraestrutura ou serviços pagos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segredos e tokens podem conceder acesso a contas, código, infraestrutura ou serviços pagos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemligheter och token kan ge åtkomst till konton, kod, infrastruktur eller betalda tjänster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırlar ve jetonlar, hesaplara, koda, altyapıya veya ücretli hizmetlere erişim izni verebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥和令牌可授予对帐户、代码、基础设施或付费服务的访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
