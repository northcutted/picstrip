    "Identity details can support impersonation, account recovery abuse, or public-record matching." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لتفاصيل الهوية أن تدعم الانتحال، أو إساءة استخدام استعادة الحساب، أو مطابقة السجلات العامة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitätsdaten können zur Identitätsübernahme, zum Missbrauch bei der Kontowiederherstellung oder zum Abgleichen mit öffentlichen Registern verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Identity details can support impersonation, account recovery abuse, or public-record matching."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los detalles de identidad pueden facilitar la suplantación, el abuso en recuperación de cuentas o la coincidencia con registros públicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d’identification peuvent faciliter l’usurpation d’identité, l’exploitation de la récupération de compte, ou la correspondance avec des archives publiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dettagli di identità possono facilitare furti d'identità, abusi nel recupero account o l'abbinamento con registri pubblici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人確認情報はなりすまし、アカウント復旧の悪用、または公的記録の照合を助長する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신원 정보는 사칭, 계정 복구 남용 또는 공공 기록 대조에 사용될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identiteitsgegevens kunnen identiteitsfraude, misbruik bij accountherstel of overeenstemming met openbare registers mogelijk maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane tożsamości mogą być wykorzystane do podszywania się, nadużyć podczas odzyskiwania konta lub dopasowywania danych z rejestrów publicznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhes de identidade podem facilitar personificação, abuso na recuperação de conta ou correspondência de registros públicos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhes de identidade podem apoiar personificação, abuso na recuperação de conta ou correspondência de registos públicos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitetsuppgifter kan stödja identitetskapning, missbruk vid kontåterställning eller matchning med offentliga register."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik bilgileri, taklitçilik, hesap kurtarma suistimali veya kamu kayıtları ile eşleştirme için kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身份信息可能助长冒充帐号、账户恢复滥用或公开记录匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身份詳細資訊可能支援冒充、帳戶恢復濫用或公開記錄匹配。"
          }
        }
      }
    },
