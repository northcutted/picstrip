    "Only without covered details, and not as PNG: the motion would still show them." : {
      "comment" : "Why Keep Live Photo motion is unavailable: details are covered or the format is PNG.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط دون تفاصيل محجوبة وليس بتنسيق PNG: فالحركة ستُظهرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ohne verdeckte Details und nicht als PNG: Die Bewegung würde sie noch zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sin detalles censurados y no en PNG: el movimiento aún los mostraría."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sin detalles censurados y no en PNG: el movimiento aún los mostraría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement sans détails masqués, et pas en PNG : l’animation les montrerait encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo senza dettagli coperti e non in PNG: il movimento li mostrerebbe ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠した項目がなく、PNG以外の場合のみ。動きには隠した内容が映ってしまうためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가린 항목이 없고 PNG가 아닐 때만 가능합니다. 움직임에는 가린 내용이 그대로 보이기 때문입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen zonder afgedekte gegevens en niet als PNG: de beweging zou ze nog laten zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko bez zamazanych danych i nie w formacie PNG: ruch nadal by je pokazywał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente sem detalhes ocultos e fora do PNG: o movimento ainda os mostraria."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas sem detalhes ocultados e não em PNG: o movimento continuaria a mostrá-los."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara utan maskerade detaljer och inte som PNG: rörelsen skulle fortfarande visa dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca karartılmış ayrıntı yoksa ve PNG değilse: hareket onları yine gösterirdi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在没有遮盖内容且不是 PNG 时可用：动态画面仍会显示这些内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
