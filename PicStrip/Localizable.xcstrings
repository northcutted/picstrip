    "Whiteboard or sticky-note passwords detected via keyword + separator heuristic" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات المرور المكتوبة على اللوحات أو الملاحظات اللاصقة، يتم كشفها عبر كلمات دالة وفواصل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter auf Whiteboards oder Haftnotizen, erkannt über Schlüsselwort- und Trennzeichen-Heuristik"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseñas escritas en pizarras o notas adhesivas, detectadas mediante una heurística de palabra clave + separador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mots de passe sur tableau blanc ou note autocollante, détectés par heuristique mot-clé + séparateur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password su lavagne o foglietti adesivi rilevate con un’euristica di parole chiave e separatori"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホワイトボードや付箋に書かれたパスワードを、キーワードと区切り文字のヒューリスティックで検出"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드와 구분 기호 휴리스틱으로 감지한 화이트보드 또는 메모지 비밀번호"
          }
        },
        "nl" : {
