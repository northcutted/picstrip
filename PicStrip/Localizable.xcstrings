            "value" : "피사체 선택 모델을 다운로드할 수 없습니다. 드래그하여 가림 상자를 그릴 수는 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het model voor objectselectie kon niet worden gedownload. Je kunt nog steeds slepen om een vak te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
