    "Publishing and editorial metadata: captions, credit lines, keywords, and contact information. Often contains your name, job title, or email address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيانات الوصفية للنشر والتحرير: التسميات التوضيحية، وخطوط الحقوق، والكلمات المفتاحية، ومعلومات الاتصال. غالبًا ما تحتوي على اسمك أو مسمّاك الوظيفي أو عنوان بريدك الإلكتروني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadaten aus Veröffentlichung und Presse: Bildunterschriften, Bildnachweise, Schlagwörter und Kontaktdaten. Enthält oft deinen Namen, deine Berufsbezeichnung oder deine E-Mail-Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Publishing and editorial metadata: captions, credit lines, keywords, and contact information. Often contains your name, job title, or email address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadatos de publicación y edición: pies de foto, créditos, palabras clave e información de contacto. A menudo incluyen tu nombre, tu puesto o tu correo electrónico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadatos de publicación y edición: pies de foto, créditos, palabras clave e información de contacto. A menudo incluyen tu nombre, tu puesto o tu correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Métadonnées de publication et d’édition : légendes, crédits, mots-clés et coordonnées. Contiennent souvent votre nom, votre fonction ou votre adresse e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadati editoriali e di pubblicazione: didascalie, crediti, parole chiave e informazioni di contatto. Spesso contengono il tuo nome, la tua qualifica o il tuo indirizzo email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開および編集メタデータ：キャプション、クレジットライン、キーワード、連絡先情報。多くの場合、あなたの名前、役職、またはメールアドレスが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시 및 편집용 메타데이터: 캡션, 크레딧 표기, 키워드, 연락처 정보. 이름, 직함, 이메일 주소가 포함되는 경우가 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicatie- en redactionele metadata: bijschriften, naamsvermeldingen, trefwoorden en contactgegevens. Bevat vaak je naam, functietitel of e-mailadres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadane wydawnicze i redakcyjne: podpisy, informacje o autorze, słowa kluczowe i dane kontaktowe. Często zawierają Twoje imię i nazwisko, stanowisko lub adres e-mail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicação e metadados editoriais: legendas, créditos, palavras-chave e informações de contato. Frequentemente contém seu nome, cargo ou endereço de e-mail."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicação e metadados editoriais: legendas, créditos, palavras-chave e informações de contacto. Contêm frequentemente o seu nome, cargo ou endereço de e-mail."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadata för publicering och redaktionellt arbete: bildtexter, krediteringar, nyckelord och kontaktuppgifter. Innehåller ofta ditt namn, din jobbtitel eller din e-postadress."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayıncılık ve editoryal meta veriler: fotoğraf açıklamaları, künye bilgileri, anahtar kelimeler ve iletişim bilgileri. Genellikle adınızı, iş unvanınızı veya e-posta adresinizi içerir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出版和编辑类元数据：图片说明、署名、关键词和联系信息。通常包含你的姓名、职位或电子邮件地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出版與編輯用的後設資料：圖說、版權聲明、關鍵字和聯絡資訊。通常包含你的姓名、職稱或電子郵件地址。"
          }
        }
      }
    },
