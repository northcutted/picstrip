            "state": "translated",
            "value": "^[%lld foto](inflect: true) rensade och sparade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld fotoğraf](inflect: true) başarıyla temizlendi ve kaydedildi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنظيف وحفظ ^[%lld صورة](inflect: true) بنجاح."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成功清理並保存了^[%lld 張照片](inflect: true)。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld foto](inflect: true) limpas e guardadas com sucesso."
          }
        }
      }
    },
    "Tap to review": {
