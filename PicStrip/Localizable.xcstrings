            "value": "隠れたメタデータ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的元数据"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados ocultos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 메타데이터"
          }
        },
