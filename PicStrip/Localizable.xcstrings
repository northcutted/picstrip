    "Live preview is a guide. After capture, review the full scan and choose what to cover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعاينة المباشرة استرشادية. بعد الالتقاط، راجع الفحص الكامل واختر ما تريد تغطيته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Live-Vorschau dient als Orientierung. Prüfe nach der Aufnahme den vollständigen Scan und wähle, was verdeckt wird."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista en directo sirve de guía. Tras capturar, revisa el análisis completo y elige qué censurar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista en directo sirve de guía. Tras capturar, revisa el análisis completo y elige qué censurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu en direct sert de guide. Après la capture, vérifiez l’analyse complète et choisissez quoi masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anteprima dal vivo è una guida. Dopo lo scatto, controlla l’analisi completa e scegli cosa coprire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブプレビューは目安です。撮影後にスキャン結果全体を確認し、隠す内容を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 미리보기는 참고용입니다. 촬영 후 전체 스캔 결과를 검토하고 가릴 내용을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het livevoorbeeld is een hulpmiddel. Controleer na de opname de volledige scan en kies wat je afdekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd na żywo jest wskazówką. Po zrobieniu zdjęcia sprawdź pełny skan i wybierz treści do zamazania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prévia ao vivo serve como guia. Após capturar, revise a análise completa e escolha o que cobrir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pré-visualização ao vivo serve como guia. Após capturar, reveja a análise completa e escolha o que cobrir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveförhandsvisningen är vägledande. Granska hela analysen efter fotograferingen och välj vad som ska döljas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı önizleme yol göstericidir. Çekimden sonra tam taramayı inceleyin ve nelerin örtüleceğini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时预览仅供参考。拍摄后请检查完整扫描结果，并选择要遮盖的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時預覽僅供參考。拍攝後請檢查完整掃描結果，並選擇要遮蓋的內容。"
          }
        }
      }
    },
    "Live scan paused while the device cools" : {
      "comment" : "Status line in the in-app camera: the phone is too hot, so the live check for sensitive details stops until it cools down. The camera still works.",
      "localizations" : {
        "ar" : {
