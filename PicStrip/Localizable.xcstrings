    "Email addresses can connect a photo to accounts, breach data, social profiles, and workplace identity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Email addresses can connect a photo to accounts, breach data, social profiles, and workplace identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de correo electrónico pueden conectar una foto con cuentas, datos filtrados, perfiles sociales e identidad laboral."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件地址可能將照片與帳戶、數據洩露、社交資料及工作身份連結起來。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereços de email podem ligar uma foto a contas, dados comprometidos, perfis sociais e identidade no trabalho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses e-mail peuvent relier une photo à des comptes, violer des données, des profils sociaux et l'identité professionnelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adressen können ein Foto mit Konten, Datenlecks, sozialen Profilen und der beruflichen Identität verknüpfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスは写真をアカウント、データ侵害、ソーシャルプロフィール、職場の身元と結びつけることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件地址可以将照片关联到帐户、数据泄露、社交资料和工作身份。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereços de email podem conectar uma foto a contas, violações de dados, perfis sociais e identidade no trabalho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소는 사진을 계정, 데이터 유출, SNS 프로필, 직장 신원과 연결할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi email possono collegare una foto a account, violazioni di dati, profili sociali e identità lavorative."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailadressen kunnen een foto koppelen aan accounts, datalekken, sociale profielen en werkidentiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresy e-mail mogą powiązać zdjęcie z kontami, wyciekami danych, profilami społecznymi i tożsamością zawodową."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postadresser kan koppla ett foto till konton, dataintrång, sociala profiler och arbetsidentitet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresleri bir fotoğrafı hesaplara, veri ihlallerine, sosyal profillere ve iş yeri kimliğine bağlayabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لعناوين البريد الإلكتروني ربط صورة بحسابات، خروقات بيانات، ملفات تعريف اجتماعية، وهوية في مكان العمل."
          }
        }
      }
    },
