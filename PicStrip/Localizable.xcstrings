    },
    "This device cannot play the preview, so it shows one frame. Tap a row to see it covered." : {
      "comment" : "Footer under the video preview when the device cannot play it with the covers.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذا الجهاز تشغيل المعاينة، لذا تعرض إطارًا واحدًا. اضغط على صف لرؤيته محجوبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann die Vorschau nicht abspielen, daher wird ein Einzelbild gezeigt. Tippe auf eine Zeile, um sie verdeckt zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no puede reproducir la vista previa, así que muestra un fotograma. Toca una fila para verla censurada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no puede reproducir la vista previa, así que muestra un cuadro. Toca una fila para verla censurada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut pas lire l’aperçu, il en affiche donc une seule image. Touchez une ligne pour la voir masquée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può riprodurre l’anteprima, quindi ne mostra un fotogramma. Tocca una riga per vederla coperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではプレビューを再生できないため、1コマを表示しています。行をタップすると、マスクされた状態を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 미리보기를 재생할 수 없어 한 프레임만 보여 줍니다. 행을 탭하면 가려진 모습을 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat kan de voorvertoning niet afspelen en toont daarom één beeld. Tik op een rij om deze afgedekt te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie nie może odtworzyć podglądu, więc pokazuje jedną klatkę. Stuknij wiersz, aby zobaczyć go zamazanego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue reproduzir a pré-visualização, então mostra um quadro. Toque em uma linha para vê-la oculta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue reproduzir a pré-visualização, por isso mostra uma imagem. Toque numa linha para a ver oculta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte spela upp förhandsvisningen, så den visar en bildruta. Tryck på en rad för att se den maskerad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz önizlemeyi oynatamıyor, bu nedenle tek bir kare gösteriliyor. Karartılmış hâlini görmek için bir satıra dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法播放预览，因此只显示一帧。轻点一行即可查看遮盖效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置無法播放預覽，因此只顯示一個畫面。點一下一列即可查看遮蓋效果。"
          }
        }
      }
    },
    "This image exceeds the editor's 25 megapixel limit. Make a copy up to 12 megapixels to review and share. Your original stays unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز هذه الصورة حد المحرر البالغ 25 ميغابكسل. أنشئ نسخة حتى 12 ميغابكسل للمراجعة والمشاركة. يبقى الأصل دون تغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bild überschreitet die 25-Megapixel-Grenze des Editors. Erstelle eine Kopie mit bis zu 12 Megapixeln zum Prüfen und Teilen. Das Original bleibt unverändert."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagen supera el límite de 25 megapíxeles del editor. Crea una copia de hasta 12 megapíxeles para revisar y compartir. El original no cambia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagen supera el límite de 25 megapíxeles del editor. Crea una copia de hasta 12 megapíxeles para revisar y compartir. El original no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette image dépasse la limite de 25 mégapixels de l’éditeur. Créez une copie jusqu’à 12 mégapixels pour la vérifier et la partager. L’original reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa immagine supera il limite di 25 megapixel dell’editor. Crea una copia fino a 12 megapixel da controllare e condividere. L’originale resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画像は編集画面の上限2500万画素を超えています。確認と共有のため、最大1200万画素のコピーを作成してください。元画像は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이미지는 편집기의 2500만 화소 한도를 초과합니다. 검토 및 공유를 위해 최대 1200만 화소 사본을 만드세요. 원본은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze afbeelding overschrijdt de editorlimiet van 25 megapixel. Maak een kopie tot 12 megapixel om te controleren en te delen. Het origineel blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraz przekracza limit edytora wynoszący 25 megapiksele. Utwórz kopię do 12 megapikseli do sprawdzenia i udostępnienia. Oryginał pozostanie bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagem excede o limite de 25 megapixels do editor. Crie uma cópia de até 12 megapixels para revisar e compartilhar. O original permanece inalterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagem excede o limite de 25 megapixels do editor. Crie uma cópia de até 12 megapixels para revisar e partilhar. O original permanece inalterado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilden överskrider redigerarens gräns på 25 megapixlar. Skapa en kopia på upp till 12 megapixlar för att granska och dela. Originalet förblir oförändrat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu görüntü düzenleyicinin 25 megapiksel sınırını aşıyor. İncelemek ve paylaşmak için en fazla 12 megapiksellik bir kopya oluşturun. Özgün görüntü değişmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张图像超过编辑器的2500万像素上限。请创建最高1200万像素的副本以供检查和分享。原图不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
