    "High efficiency. Apple OS may inject Maker data upon saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "High efficiency. Apple OS may inject Maker data upon saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta eficiencia. El sistema operativo Apple puede agregar datos del Fabricante al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haute efficacité. Le système Apple peut injecter des données du fabricant lors de l’enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Effizienz. Apple OS kann beim Speichern Herstellerdaten einfügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高効率。Apple OSは保存時にメーカー情報を挿入する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高效率。Apple 操作系统在保存时可能会注入制造商数据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta eficiência. O sistema Apple pode inserir dados do fabricante ao salvar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 효율성. Apple OS는 저장 시 제조사 데이터를 삽입할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta efficienza. Il sistema operativo Apple può inserire i dati del produttore durante il salvataggio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoge efficiëntie. Apple OS kan bij het opslaan gegevens van de maker toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoka wydajność. System Apple może wstrzykiwać dane producenta podczas zapisywania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hög effektivitet. Apple OS kan injicera tillverkaruppgifter vid sparande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek verimlilik. Apple OS, kaydetme sırasında üretici verilerini ekleyebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كفاءة عالية. قد يضيف نظام Apple بيانات الصانع عند الحفظ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高效率。Apple OS 可能於儲存時注入製造商資料。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta eficiência. O sistema Apple pode inserir dados do fabricante ao salvar."
          }
        }
      }
    },
