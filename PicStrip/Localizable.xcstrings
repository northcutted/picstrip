    "Keep PicStrip open. The screen stays on until the batch is done." : {
      "comment" : "Under the batch progress bar when videos are in the batch.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ PicStrip مفتوحًا. تبقى الشاشة مضاءة حتى تنتهي معالجة الدفعة."
