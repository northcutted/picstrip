    "You can still cover objects yourself, bleep the sound, or save a copy with only the hidden details removed." : {
      "comment" : "Footer when a video scan found no faces or sensitive text.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال بإمكانك حجب العناصر بنفسك أو إضافة صفير على الصوت أو حفظ نسخة أُزيلت منها التفاصيل المخفية فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst trotzdem selbst Objekte verdecken, den Ton überpiepen oder eine Kopie sichern, bei der nur die versteckten Details entfernt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aun así puedes censurar objetos tú mismo, poner un pitido al sonido o guardar una copia sin los detalles ocultos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aun así puedes censurar objetos tú mismo, poner un pitido al sonido o guardar una copia sin los detalles ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toujours masquer des objets vous-même, biper le son ou enregistrer une copie dont seuls les détails cachés sont supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque coprire tu stesso degli oggetti, mettere un bip sull’audio o salvare una copia senza i dettagli nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分でオブジェクトをマスクしたり、音声にピー音を入れたり、隠れた情報だけを削除したコピーを保存したりすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 개체를 가리거나, 소리에 삐 소리를 넣거나, 숨겨진 정보만 제거한 사본을 저장할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nog steeds zelf objecten afdekken, het geluid laten piepen of een kopie bewaren waarin alleen verborgen gegevens zijn verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal możesz samodzielnie zamazać obiekty, zagłuszyć dźwięk piskiem lub zachować kopię bez ukrytych danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda pode ocultar objetos por conta própria, colocar um bipe no som ou salvar uma cópia apenas sem os detalhes ocultos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ainda ocultar objetos por si, pôr um bipe no som ou guardar uma cópia apenas sem os detalhes ocultos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortfarande maskera objekt själv, lägga pip över ljudet eller spara en kopia där bara dolda uppgifter är borttagna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yine de nesneleri kendiniz karartabilir, sese bip sesi ekleyebilir veya yalnızca gizli ayrıntıları kaldırılmış bir kopya kaydedebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍然可以自行遮盖物体、为声音加上哔声，或存储一份只移除了隐藏信息的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍然可以自行遮蓋物體、為聲音加上嗶聲，或儲存一份只移除了隱藏資訊的拷貝。"
          }
        }
      }
    },
