    "Whiteboard or sticky-note passwords detected via keyword + separator heuristic": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseñas en pizarras o notas adhesivas detectadas mediante heurística de palabra clave + separador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots de passe sur tableau blanc ou notes autocollantes détectés via une heuristique mot-clé + séparateur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter auf Whiteboards oder Haftnotizen erkannt durch Stichwort- und Trennzeichen-Heuristik"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホワイトボードや付箋のパスワードがキーワード+区切り文字のヒューリスティックで検出されました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过关键词+分隔符启发式检测到白板或便签密码"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senhas em quadro branco ou em notas adesivas detectadas por heurística de palavra-chave + separador"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키워드+구분자 휴리스틱을 통해 화이트보드 또는 포스트잇 비밀번호 감지됨"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Password su lavagne o note adesive rilevate tramite euristica parola chiave + separatore"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachtwoorden op whiteboard of plakbriefje gedetecteerd via trefwoord + scheidingsteken heuristiek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasła na tablicy lub karteczkach samoprzylepnych wykryte za pomocą heurystyki słowa kluczowego + separatora"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenord på whiteboard eller klisterlappar upptäckta via nyckelord + skiljetecken heuristik"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kelime + ayraç kuralı ile beyaz tahta ya da yapışkan not şifreleri tespit edildi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الكشف عن كلمات مرور السبورة البيضاء أو الملصقات اللاصقة عبر قاعدة مفتاحية + فاصل"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白板或便利貼密碼透過關鍵字+分隔符啟發式偵測到"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Senhas em quadro branco ou notas autocolantes detetadas através da heurística palavra-chave + separador"
          }
        }
      }
    },
