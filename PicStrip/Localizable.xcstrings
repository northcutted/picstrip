    "High efficiency. Apple OS may inject Maker data upon saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كفاءة عالية. قد يضيف نظام Apple بيانات الصانع عند الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Effizienz. Das Apple-Betriebssystem kann beim Sichern Herstellerdaten einfügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High efficiency. Apple OS may inject Maker data upon saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta eficiencia. El sistema operativo de Apple puede añadir datos de Maker Note al guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haute efficacité. Le système Apple peut injecter des données du fabricant lors de l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta efficienza. Il sistema operativo Apple può inserire i dati del produttore durante il salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高効率。Apple OSは保存時にメーカー情報を挿入する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고효율. 저장할 때 Apple OS가 Maker Note 데이터를 넣을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoge efficiëntie. Het besturingssysteem kan bij het bewaren Maker Note-gegevens toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysoka wydajność. System Apple może dodać dane Maker Note podczas zachowywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta eficiência. O sistema Apple pode inserir dados do fabricante ao salvar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta eficiência. O sistema Apple pode inserir dados do fabricante ao guardar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hög effektivitet. Apples system kan lägga till Maker-data när bilden sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek verimlilik. Apple OS, kaydetme sırasında üretici verilerini ekleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
