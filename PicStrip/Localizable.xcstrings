          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip 是基於一個原則打造的:隱私。該應用旨在幫助您避免分享您不想分享的內容。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip foi criado com um único princípio: Privacidade. A aplicação existe para ajudar a evitar que partilhe coisas que não pretende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip a été conçu selon un seul principe : la confidentialité. L'application existe pour vous aider à éviter de partager des choses que vous ne souhaitez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip wurde nach dem einzigen Prinzip entwickelt: Datenschutz. Die App soll Ihnen helfen, Dinge nicht zu teilen, die Sie nicht teilen möchten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStripは、たった一つの原則、プライバシーのために作られました。このアプリは、意図しない共有を避けるために存在しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip建立在一个原则之上:隐私。该应用旨在帮助您避免分享您不想分享的内容。"
          }
        }
      }
    },
    "PicStrip works completely offline. It makes zero network requests. Ever.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip funciona completamente sin conexión. No realiza ninguna solicitud de red. Nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip fonctionne entièrement hors ligne. Il ne fait aucune requête réseau. Jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip funktioniert komplett offline. Es werden keine Netzwerkverbindungen aufgebaut. Niemals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStripは完全にオフラインで動作します。ネットワークへのリクエストは一切行いません。絶対に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip 完全离线运行。它不进行任何网络请求。永远不会。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip funciona completamente offline. Não faz nenhuma solicitação de rede. Nunca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip은 완전히 오프라인으로 작동합니다. 네트워크 요청을 전혀 하지 않습니다. 절대요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip funziona completamente offline. Non effettua alcuna richiesta di rete. Mai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip werkt volledig offline. Het doet geen enkele netwerkverzoek. Nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip działa całkowicie offline. Nie wysyła żadnych zapytań sieciowych. Nigdy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip fungerar helt offline. Den gör inga nätverksförfrågningar. Aldrig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip tamamen çevrimdışıdır. Ağ isteği yapmaz. Asla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل PicStrip بشكل كامل في وضع عدم الاتصال. لا يقوم بأي طلبات للشبكة. أبداً."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip 完全離線運作。它從不發送任何網路請求。永遠不會。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip funciona completamente offline. Não faz nenhuma solicitação de rede. Nunca."
          }
        }
      }
    },
    "Pinch to zoom and drag to pan": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " pellizca para hacer zoom y arrastra para desplazar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoomer et faites glisser pour déplacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zummen durch Kneifen und zum Verschieben ziehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチでズーム、ドラッグでパンします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合以缩放,拖动以平移。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte para dar zoom e arraste para mover."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대하려면 집게 손가락으로 움직이고, 팬하려면 드래그하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica per zoomare e trascina per spostarti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijp om te zoomen en sleep om te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczypnij, aby powiększyć i przeciągnij, aby przesunąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp för att zooma och dra för att panorera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak için kıstırın ve kaydırmak için sürükleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرص لتكبير واسحب للتنقل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合以縮放,拖動以平移。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte para ampliar e arraste para mover."
          }
        }
      }
    },
