          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe e salve uma foto para criar um resumo agregado de privacidade."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
