    "Maximum Privacy. Prevents OS from injecting format headers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Maximum Privacy. Prevents OS from injecting format headers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidad máxima. Evita que el sistema operativo inyecte encabezados de formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité maximale. Empêche le système d’exploitation d’injecter des en-têtes de format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Privatsphäre. Verhindert, dass das Betriebssystem Formatüberschriften einfügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大限のプライバシー。OSがフォーマットヘッダーを挿入するのを防ぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大隐私。防止操作系统注入格式头。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade máxima. Impede que o sistema operativo injete cabeçalhos de formato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 개인정보 보호. 운영 체제가 포맷 헤더를 삽입하지 않도록 방지합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massima privacy. Impedisce al sistema operativo di inserire intestazioni di formato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale privacy. Voorkomt dat het besturingssysteem formaatheaders injecteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalna prywatność. Zapobiega wstrzykiwaniu nagłówków formatowania przez system operacyjny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximal integritet. Förhindrar att operativsystemet lägger till formatrubriker."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum gizlilik. İşletim sisteminin format başlıkları eklemesini engeller."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصوصية قصوى. يمنع نظام التشغيل من إدخال رؤوس التنسيق."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大隱私。防止作業系統注入格式標頭。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade máxima. Evita que o sistema operativo injete cabeçalhos de formato."
          }
        }
      }
    },
