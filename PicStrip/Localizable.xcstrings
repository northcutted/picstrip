            "value" : "خطر فوري باختراق الحساب أو احتيال مالي كبير. أرقام SSN وأرقام بطاقات الائتمان ومفاتيح API والمفاتيح الخاصة وبيانات اعتماد قواعد البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unmittelbare Gefahr von Kontoübernahme oder schwerem Finanzbetrug. SSNs, Kreditkartennummern, API-Schlüssel, private Schlüssel, Datenbank-Zugangsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesgo inmediato de robo de cuentas o de fraude financiero grave. SSN, números de tarjeta de crédito, claves API, claves privadas, credenciales de bases de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risque immédiat de piratage de compte ou de fraude financière majeure. Numéros SSN, numéros de carte de crédit, clés API, clés privées, identifiants de bases de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rischio immediato di furto dell’account o di gravi frodi finanziarie. SSN, numeri di carte di credito, chiavi API, chiavi private, credenziali di database."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントの即時乗っ取りや重大な金銭的詐欺のリスク。SSN、クレジットカード番号、APIキー、秘密鍵、データベースの認証情報など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉각적인 계정 탈취나 심각한 금융 사기 위험이 있습니다. SSN, 신용카드 번호, API 키, 개인 키, 데이터베이스 자격 증명."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct risico op accountovername of grote financiële fraude. SSN’s, creditcardnummers, API-sleutels, privésleutels, database-inloggegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryzyko natychmiastowego przejęcia konta lub poważnego oszustwa finansowego. Numery SSN, numery kart kredytowych, klucze API, klucze prywatne, dane dostępowe do baz danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risco imediato de invasão de contas ou fraude financeira grave. SSNs, números de cartão de crédito, chaves de API, chaves privadas, credenciais de banco de dados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risco imediato de tomada de controlo de contas ou de fraude financeira grave. Números de SSN, números de cartão de crédito, chaves de API, chaves privadas e credenciais de bases de dados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risk för omedelbar kontokapning eller allvarligt ekonomiskt bedrägeri. Socialförsäkringsnummer, kreditkortsnummer, API-nycklar, privata nycklar, inloggningsuppgifter till databaser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anında hesap ele geçirme veya büyük mali dolandırıcılık riski. SSN’ler, kredi kartı numaraları, API anahtarları, özel anahtarlar, veritabanı kimlik bilgileri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能立即导致账户被盗用或重大金融诈骗。SSN、信用卡号码、API 密钥、私钥、数据库凭证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳號可能立即被盜用，或造成重大財務詐騙。SSN、信用卡號碼、API 金鑰、私密金鑰、資料庫憑證。"
          }
        }
      }
    },
