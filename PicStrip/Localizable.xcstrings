          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーニング後、オリジナルの写真は完全に削除されます。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 사진은 정리 후 영구 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De originele foto’s worden na het opschonen permanent verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oryginalne zdjęcia zostaną trwale usunięte po oczyszczeniu. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos originais serão excluídas permanentemente após a limpeza. Isto não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos originais serão eliminadas permanentemente após a limpeza. Isto não pode ser desfeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ursprungliga fotona kommer att raderas permanent efter rensningen. Detta kan inte ångras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal fotoğraflar temizleme işleminden sonra kalıcı olarak silinecektir. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理后,原始照片将被永久删除,此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理後,原始照片將被永久刪除,無法復原。"
          }
        }
      }
    },
    "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع الدقيق الذي تم التقاط هذه الصورة فيه – خط العرض وخط الطول والارتفاع. مشاركته يكشف المكان الذي تعيش أو تعمل أو تسافر إليه، ويمكن استخدامه لتتبع تحركاتك مع مرور الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der genaue Ort, an dem dieses Foto aufgenommen wurde – Breite, Länge und Höhe. Das Teilen zeigt, wo Sie leben, arbeiten oder reisen, und kann verwendet werden, um Ihre Bewegungen im Laufe der Zeit zu verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The precise location where this photo was taken — latitude, longitude, and altitude. Sharing it reveals where you live, work, or travel, and can be used to track your movements over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación exacta donde se tomó esta foto — latitud, longitud y altitud. Compartirla revela dónde vives, trabajas o viajas, y puede usarse para rastrear tus movimientos con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emplacement précis où cette photo a été prise — latitude, longitude et altitude. Le partager révèle où vous vivez, travaillez ou voyagez, et peut permettre de suivre vos déplacements au fil du temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione precisa in cui è stata scattata questa foto — latitudine, longitudine e altitudine. Condividerla rivela dove vivi, lavori o viaggi e può essere usata per tracciare i tuoi spostamenti nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真が撮影された正確な位置情報(緯度、経度、高度)。共有すると、あなたがどこに住み、働き、旅行しているかを明らかにし、時間をかけて行動を追跡される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진이 찍힌 정확한 위치 — 위도, 경도, 고도. 공유하면 거주지, 근무지 또는 여행지 위치가 드러나며, 시간이 지남에 따라 이동 경로 추적에 사용될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De exacte locatie waar deze foto is genomen — breedtegraad, lengtegraad en hoogte. Delen betekent dat zichtbaar wordt waar je woont, werkt of reist, en kan worden gebruikt om je bewegingen in de tijd te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna lokalizacja wykonania tego zdjęcia – szerokość i długość geograficzna oraz wysokość. Udostępnienie tych danych ujawnia miejsce, gdzie mieszkasz, pracujesz lub podróżujesz, i może być użyte do śledzenia twoich ruchów w czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização precisa onde esta foto foi tirada — latitude, longitude e altitude. Compartilhá-la revela onde você mora, trabalha ou viaja, e pode ser usada para rastrear seus movimentos ao longo do tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização precisa onde esta foto foi tirada — latitude, longitude e altitude. Partilhá-la revela onde vive, trabalha ou viaja, e pode ser usada para rastrear os seus movimentos ao longo do tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den exakta plats där detta foto togs – latitud, longitud och altitud. Att dela det avslöjar var du bor, arbetar eller reser, och kan användas för att spåra dina rörelser över tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fotoğrafın çekildiği tam konum – enlem, boylam ve yükseklik. Paylaşmak, nerede yaşadığınızı, çalıştığınızı veya seyahat ettiğinizi ortaya çıkarır ve zaman içinde hareketlerinizi takip etmek için kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张照片拍摄的精确位置 — 纬度、经度和高度。分享这些信息会暴露您的住所、工作地点或旅行路线,并可能被用于追踪您的移动轨迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝此照片的精確位置——緯度、經度和高度。分享它會透露您居住、工作或旅行的地點,並可用於追蹤您隨時間的移動軌跡。"
          }
        }
      }
    },
