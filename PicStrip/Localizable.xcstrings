    "PicStrip could not read “%@”. No images were returned." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على PicStrip قراءة ”%@“. لم يتم إرجاع أي صور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip konnte „%@“ nicht lesen. Es wurden keine Bilder zurückgegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip no ha podido leer «%@». No se ha devuelto ninguna imagen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip no pudo leer “%@”. No se devolvió ninguna imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip n’a pas pu lire « %@ ». Aucune image n’a été renvoyée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip non è riuscito a leggere “%@”. Non è stata restituita alcuna immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStripは「%@」を読み込めませんでした。画像は返されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip이 ‘%@’을(를) 읽을 수 없습니다. 반환된 이미지가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip kon ‘%@’ niet lezen. Er zijn geen afbeeldingen teruggegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PicStrip nie mógł odczytać „%@”. Nie zwrócono żadnych obrazów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PicStrip não conseguiu ler “%@”. Nenhuma imagem foi retornada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PicStrip não conseguiu ler “%@”. Não foi devolvida nenhuma imagem."
          }
        },
