    "Privacy metadata is stripped automatically before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تلقائيًا إزالة بيانات التعريف الخاصة بالخصوصية قبل الحفظ."
          }
        },
        "de" : {
