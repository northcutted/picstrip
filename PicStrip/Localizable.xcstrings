    "Phone numbers can be searched, messaged, or linked to public records and account recovery flows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Phone numbers can be searched, messaged, or linked to public records and account recovery flows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de teléfono pueden ser buscados, contactados o vinculados a registros públicos y flujos de recuperación de cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros de téléphone peuvent être recherchés, contactés par message, ou associés à des registres publics et des processus de récupération de compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonnummer können gesucht, angeschrieben oder mit öffentlichen Aufzeichnungen und Kontowiederherstellungsabläufen verknüpft werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話番号は検索、メッセージ送信、または公的記録やアカウント回復のフローに関連付けることができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电话号码可以被搜索、发送消息,或链接到公共记录和账户恢复流程。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Números de telefone podem ser pesquisados, enviados mensagens ou vinculados a registros públicos e fluxos de recuperação de conta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화번호는 검색, 메시지 발송, 공개 기록 및 계정 복구 절차에 연결될 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri di telefono possono essere cercati, messaggiati o collegati a registri pubblici e procedure di recupero account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoonnummers kunnen worden gezocht, bericht gestuurd of gekoppeld aan openbare registers en accountherstelflows."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numery telefonów mogą być wyszukiwane, otrzymywać wiadomości lub są powiązane z rejestrami publicznymi oraz procesami odzyskiwania konta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonnummer kan sökas, meddelas eller länkas till offentliga register och kontåterställningsflöden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon numaraları aranabilir, mesaj gönderilebilir veya kamu kayıtları ve hesap kurtarma süreçlerine bağlanabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن البحث عن أرقام الهواتف، أو إرسال رسائل إليها، أو ربطها بالسجلات العامة وسير استعادة الحساب."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電話號碼可以被搜尋、發送訊息,或連結到公開紀錄和帳戶恢復流程。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números de telefone podem ser pesquisados, mensageados ou ligados a registos públicos e fluxos de recuperação de conta."
          }
        }
      }
    },
    "Photo library access was denied. Please enable it in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Photo library access was denied. Please enable it in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la biblioteca de fotos fue denegado. Por favor, actívelo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la photothèque a été refusé. Veuillez l'activer dans les Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Fotobibliothek wurde verweigert. Bitte aktivieren Sie ihn in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリへのアクセスが拒否されました。設定で有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片图库访问被拒绝。请在“设置”中启用访问权限。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à biblioteca de fotos foi negado. Por favor, habilite-o nas Configurações."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함 접근이 거부되었습니다. 설정에서 허용해 주세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla libreria foto è stato negato. Attivalo nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot fotobibliotheek is geweigerd. Gelieve dit in de Instellingen in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do biblioteki zdjęć został odmówiony. Proszę włączyć go w Ustawieniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till fotobiblioteket nekades. Aktivera det i Inställningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf kütüphanesi erişimi reddedildi. Lütfen Ayarlar'dan etkinleştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى مكتبة الصور. يرجى تمكينه في الإعدادات."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕了對相簿的訪問。請在設定中啟用此功能。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à biblioteca de fotos foi negado. Por favor, ative-o nas Definições."
          }
        }
      }
    },
