    "Your photos are never uploaded to any server. All scanning, redaction, and metadata stripping happens entirely on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos nunca se suben a ningún servidor. Todo el escaneo, la redacción y la eliminación de metadatos se realizan completamente en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos ne sont jamais téléchargées sur un serveur. Tout le scan, le masquage et la suppression des métadonnées se font entièrement sur votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos werden niemals auf einen Server hochgeladen. Das gesamte Scannen, Schwärzen und Entfernen von Metadaten erfolgt ausschließlich auf deinem iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの写真は決してサーバーにアップロードされません。すべてのスキャン、編集、メタデータの削除は完全にあなたのiPhone上で行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的照片绝不会上传到任何服务器。所有扫描、编辑和元数据剥离均完全在您的 iPhone 上完成。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos nunca são enviadas para qualquer servidor. Todo o escaneamento, edição e remoção de metadados acontece inteiramente no seu iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 사진은 어떤 서버에도 업로드되지 않습니다. 모든 스캔, 수정 및 메타데이터 제거가 전적으로 귀하의 iPhone에서 이루어집니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto non vengono mai caricate su nessun server. La scansione, la redazione e la rimozione dei metadati avvengono interamente sul tuo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto worden nooit naar een server geüpload. Alle scan-, zwartmaak- en metadata-verwijderingsprocessen vinden volledig op je iPhone plaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zdjęcia nigdy nie są przesyłane na serwer. Wszystkie skanowanie, redakcja i usuwanie metadanych odbywają się całkowicie na Twoim iPhonie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina foton laddas aldrig upp till någon server. All skanning, överstrykning och borttagning av metadata sker helt på din iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınız hiçbir sunucuya yüklenmez. Tüm tarama, sansürleme ve meta verilerin kaldırılması tamamen iPhone’unuzda gerçekleşir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورك لا تُحمّل أبدًا على أي خادم. تتم جميع عمليات المسح والحجب وإزالة بيانات التعريف بشكل كامل على iPhone الخاص بك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的照片絕不會上傳到任何伺服器。所有檢測、馬賽克處理和去除元資料操作全部在您的 iPhone 上執行。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas fotos nunca são enviadas para nenhum servidor. Toda a digitalização, redacção e remoção de metadados acontecem inteiramente no seu iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}
