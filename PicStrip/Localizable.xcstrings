    "Positions are measured from the top-left of the image. Each adjustment can be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقاس المواضع من الزاوية العلوية اليسرى للصورة. يمكن التراجع عن كل تعديل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionen werden ab der linken oberen Bildecke gemessen. Jede Anpassung kann rückgängig gemacht werden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posiciones se miden desde la esquina superior izquierda de la imagen. Cada ajuste se puede deshacer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posiciones se miden desde la esquina superior izquierda de la imagen. Cada ajuste se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les positions sont mesurées depuis le coin supérieur gauche de l’image. Chaque ajustement peut être annulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni si misurano dall’angolo in alto a sinistra dell’immagine. Ogni regolazione può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置は画像の左上を基準に測定されます。各調整は取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치는 이미지의 왼쪽 위 모서리를 기준으로 측정됩니다. 각 조정은 실행 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posities worden gemeten vanaf de linkerbovenhoek van de afbeelding. Elke aanpassing kan ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycje są mierzone od lewego górnego rogu obrazu. Każdą zmianę można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As posições são medidas a partir do canto superior esquerdo da imagem. Cada ajuste pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As posições são medidas a partir do canto superior esquerdo da imagem. Cada ajuste pode ser desfeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positioner mäts från bildens övre vänstra hörn. Varje justering kan ångras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumlar görüntünün sol üst köşesinden ölçülür. Her ayarlama geri alınabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置从图像左上角开始测量。每次调整都可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
