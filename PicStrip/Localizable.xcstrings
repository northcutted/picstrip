    "Tap-to-select uses an Apple model downloaded with your permission. The model analyzes your photo on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم التحديد بالنقر نموذجًا من Apple يُنزَّل بإذنك. يحلل النموذج صورتك على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Objektauswahl per Tippen verwendet ein Apple-Modell, das mit deiner Zustimmung heruntergeladen wird. Es analysiert dein Foto auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selección mediante un toque utiliza un modelo de Apple que se descarga con tu permiso. El modelo analiza la foto en este dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
