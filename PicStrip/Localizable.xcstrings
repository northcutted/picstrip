    "Warning: Metadata removal is permanent. The saved image will lose Live Photo motion data, GPS location, camera model, and editing history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحذير: إزالة البيانات الوصفية دائمة. ستفقد الصورة المحفوظة بيانات حركة Live Photo، وموقع GPS، وطراز الكاميرا، وسجل التعديلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Das Entfernen der Metadaten ist endgültig. Das gesicherte Bild verliert Live-Photo-Bewegungsdaten, GPS-Standort, Kameramodell und Bearbeitungsverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia: la eliminación de metadatos es permanente. La imagen guardada perderá datos de movimiento Live Photo, ubicación GPS, modelo de cámara e historial de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : la suppression des métadonnées est définitive. L’image enregistrée perdra les données de mouvement Live Photo, la localisation GPS, le modèle de l’appareil photo et l’historique d’édition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso: la rimozione dei metadati è permanente. L’immagine salvata perderà i dati di movimento Live Photo, la posizione GPS, il modello della fotocamera e la cronologia delle modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：メタデータの削除は永久的です。保存された画像は、Live Photoの動きのデータ、GPSの位置情報、カメラモデル、編集履歴を失います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 메타데이터 제거는 영구적입니다. 저장된 이미지에서 Live Photo 모션 데이터, GPS 위치, 카메라 모델, 편집 기록이 모두 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: het verwijderen van metadata is definitief. De bewaarde afbeelding verliest Live Photo-bewegingsgegevens, GPS-locatie, cameramodel en bewerkingsgeschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie: usunięcie metadanych jest trwałe. Zachowane zdjęcie utraci dane ruchu Live Photo, lokalizację GPS, model aparatu oraz historię edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: A remoção de metadados é permanente. A imagem salva perderá dados de movimento Live Photo, localização GPS, modelo da câmera e histórico de edição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: a remoção dos metadados é permanente. A imagem guardada perderá dados de movimento do Live Photo, localização por GPS, modelo da câmara e histórico de edição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: Borttagning av metadata är permanent. Den sparade bilden kommer att förlora Live Photo-rörelsedata, GPS-plats, kameramodell och redigeringshistorik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı: Meta verilerin kaldırılması kalıcıdır. Kaydedilen görüntü, Live Photo hareket verilerini, GPS konumunu, kamera modelini ve düzenleme geçmişini kaybeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：元数据一旦移除便无法恢复。存储后的图像将失去实况照片动态数据、GPS 位置、相机型号和编辑历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：移除後設資料是永久性的動作。儲存的影像將失去原況照片的動態資料、GPS 位置、相機型號和編輯記錄。"
          }
        }
      }
    },
