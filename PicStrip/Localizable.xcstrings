    "Low-level image properties including software version, color profile, and copyright strings — which sometimes contain your real name or organisation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خصائص الصور منخفضة المستوى التي تتضمن إصدار البرنامج وملف الألوان وسلاسل حقوق الطبع والنشر — والتي تحتوي أحيانًا على اسمك الحقيقي أو المؤسسة الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische Bildeigenschaften wie Softwareversion, Farbprofil und Copyright-Angaben – die manchmal deinen echten Namen oder deine Organisation enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Low-level image properties including software version, color profile, and copyright strings — which sometimes contain your real name or organisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propiedades de imagen de bajo nivel, como la versión del software, el perfil de color y las cadenas de copyright, que a veces contienen tu nombre real o el de tu organización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriétés d’image de bas niveau incluant la version du logiciel, le profil colorimétrique et les chaînes de copyright — qui contiennent parfois votre vrai nom ou votre organisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proprietà dell’immagine a basso livello, incluse versione software, profilo colore e stringhe di copyright — che talvolta possono contenere il tuo vero nome o l’organizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトウェアバージョン、カラープロファイル、著作権表記など、時に実名や所属組織を含む低レベルな画像プロパティ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소프트웨어 버전, 색상 프로필, 저작권 문자열 등 때때로 사용자의 실제 이름이나 조직이 포함된 저수준 이미지 속성입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basale afbeeldingseigenschappen zoals softwareversie, kleurprofiel en copyrightteksten — die soms je echte naam of organisatie bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niskopoziomowe właściwości obrazu, w tym wersja oprogramowania, profil kolorów i ciągi znaków z prawami autorskimi – które czasami zawierają Twoje prawdziwe imię i nazwisko lub nazwę organizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriedades de baixo nível da imagem, incluindo versão do software, perfil de cor e textos de direitos autorais — que às vezes contêm seu nome real ou sua organização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propriedades de imagem de baixo nível, incluindo a versão do software, o perfil de cor e os textos de direitos de autor — que por vezes contêm o seu nome verdadeiro ou a sua organização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundläggande bildegenskaper som programvaruversion, färgprofil och upphovsrättstexter – som ibland innehåller ditt riktiga namn eller din organisation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazılım sürümü, renk profili ve telif hakkı dizeleri gibi alt düzey görüntü özellikleri — bunlar bazen gerçek adınızı veya kuruluşunuzu içerir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底层图像属性，包括软件版本、颜色配置文件和版权字符串——其中有时包含你的真实姓名或所属机构。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低階影像屬性，包括軟體版本、色彩描述檔和版權字串——這些字串有時會包含你的真實姓名或組織名稱。"
          }
        }
      }
    },
