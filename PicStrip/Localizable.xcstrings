            "value": "安全な再エンコード中に保存できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在安全重编码过程中无法保留。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser preservado durante a recompactação segura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 재인코딩 중에는 보존할 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può essere preservato durante la ricodifica sicura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet worden behouden tijdens veilige opnieuw codering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zachować podczas bezpiecznego ponownego kodowania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte bevaras vid säker omkodning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli yeniden kodlama sırasında korunamaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الاحتفاظ بها أثناء إعادة الترميز الآمنة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在安全重新編碼期間保留。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser preservado durante a reencodificação segura."
          }
        }
