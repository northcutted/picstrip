    "Blur and pixelation can leave details recognizable. Use Solid for secrets and identifying text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يترك التمويه والبكسلة تفاصيل يمكن التعرف عليها. استخدم تغطية معتمة للأسرار والنصوص التي تكشف الهوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weichzeichnen und Verpixeln können Details erkennbar lassen. Verwende eine deckende Fläche für Geheimnisse und identifizierenden Text."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desenfoque y el pixelado pueden dejar detalles reconocibles. Usa una cobertura sólida para secretos y texto identificativo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desenfoque y el pixelado pueden dejar detalles reconocibles. Usa una cobertura sólida para secretos y texto identificativo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flou et la pixellisation peuvent laisser des détails reconnaissables. Utilisez un aplat opaque pour les secrets et le texte identifiant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfocatura e pixelatura possono lasciare dettagli riconoscibili. Usa una copertura piena per segreti e testo identificativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼかしやモザイクでは内容を判別できる場合があります。秘密情報や個人を特定する文字には単色のマスクを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐림과 픽셀화 후에도 세부 내용을 알아볼 수 있습니다. 비밀 정보와 식별 가능한 텍스트에는 단색 가림을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaging en pixelvorming kunnen details herkenbaar laten. Gebruik een effen vlak voor geheimen en identificerende tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmycie i pikselizacja mogą pozostawić rozpoznawalne szczegóły. Do sekretów i danych identyfikacyjnych używaj pełnego krycia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque e pixelização podem deixar detalhes reconhecíveis. Use cobertura sólida para segredos e textos de identificação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque e pixelização podem deixar detalhes reconhecíveis. Utilize cobertura sólida para segredos e textos de identificação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oskärpa och pixling kan lämna igenkännbara detaljer. Använd heltäckande maskering för hemligheter och identifierande text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulanıklaştırma ve pikselleştirme ayrıntıları tanınabilir bırakabilir. Sırlar ve kimlik belirten metinler için düz, opak kaplama kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊和像素化可能仍留下可识别的细节。请用不透明的纯色遮盖秘密信息和身份识别文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊和像素化可能仍留下可辨識的細節。請用不透明的純色遮蓋祕密資訊和身分識別文字。"
          }
        }
      }
    },
