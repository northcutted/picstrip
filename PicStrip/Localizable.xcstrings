          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestandardowe zaciemnienia ukrywają wrażliwe szczegóły wizualne, których automatyczne wykrywanie może nie rozpoznać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máscaras personalizadas ocultam detalhes visuais sensíveis que a detecção automática pode não entender."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
