    "Original photos will be permanently deleted after cleaning.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos originales se eliminarán permanentemente tras la limpieza."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理後,原始照片將被永久刪除。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos originais serão eliminadas permanentemente após a limpeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos originales seront supprimées définitivement après le nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalfotos werden nach der Bereinigung dauerhaft gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルの写真は、クリーンアップ後に完全に削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理后,原始照片将被永久删除。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos originais serão excluídas permanentemente após a limpeza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 후 원본 사진은 영구 삭제됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto originali saranno eliminate definitivamente dopo la pulizia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Originele foto’s worden na het opschonen permanent verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalne zdjęcia zostaną trwale usunięte po czyszczeniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalbilder kommer att raderas permanent efter rensning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal fotoğraflar temizleme sonrası kalıcı olarak silinecektir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الصور الأصلية نهائيًا بعد التنظيف."
          }
        }
      }
    },
