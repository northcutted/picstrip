        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きを残せなかったため、静止画として保存しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임을 유지할 수 없어 사진을 정지 이미지로 저장했습니다."
