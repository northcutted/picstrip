          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak telemetrii, brak raportów o awariach, brak reklamowych SDK. Nikt nie obserwuje ani nie zbiera informacji o tym, jak korzystasz z aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
