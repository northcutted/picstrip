    "Hidden metadata like GPS coordinates, camera model, and timestamps is stripped from the file before it ever leaves your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إزالة البيانات الوصفية المخفية مثل إحداثيات GPS، نموذج الكاميرا والطوابع الزمنية من الملف قبل أن يغادر جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Metadaten wie GPS-Koordinaten, Kameramodell und Zeitstempel werden aus der Datei entfernt, bevor sie Ihr Gerät verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan los metadatos ocultos como coordenadas GPS, modelo de cámara y marcas de tiempo del archivo antes de que salga de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées cachées comme les coordonnées GPS, le modèle de l'appareil photo et les horodatages sont supprimées du fichier avant qu'il ne quitte votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I metadati nascosti come coordinate GPS, modello della fotocamera e timestamp vengono rimossi dal file prima che lasci il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠しメタデータ(GPS座標、カメラモデル、タイムスタンプなど)は、ファイルがデバイスを離れる前に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS 좌표, 카메라 모델, 타임스탬프와 같은 숨겨진 메타데이터는 파일이 기기를 벗어나기 전에 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen metadata zoals GPS-coördinaten, cameramodel en tijdstempels worden uit het bestand verwijderd voordat het uw apparaat verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryte metadane, takie jak współrzędne GPS, model aparatu i znaczniki czasowe, są usuwane z pliku zanim opuści on twoje urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadados ocultos como coordenadas GPS, modelo da câmera e carimbos de data e hora são removidos do arquivo antes dele sair do seu dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadados ocultos como coordenadas GPS, modelo da câmara e carimbos temporais são retirados do ficheiro antes de este sair do seu dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolda metadata som GPS-koordinater, kameramodell och tidsstämplar tas bort från filen innan den lämnar din enhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS koordinatları, kamera modeli ve zaman damgaları gibi gizli meta veriler, dosya cihazınızdan çıkmadan önce kaldırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的元数据,如 GPS 坐标、相机型号和时间戳,会在文件离开您的设备之前被移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏的元資料如 GPS 座標、相機型號和時間戳記會在檔案離開您的裝置前被移除。"
          }
        }
      }
    },
