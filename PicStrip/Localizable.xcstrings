          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée sans ses détails cachés. L’animation n’est pas masquée : vérifiez qu’elle ne montre rien de privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene salvato senza i dettagli nascosti. Il movimento non viene coperto, quindi verifica che non mostri nulla di privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠れた情報を削除して保存します。動きはマスクされないため、プライベートな内容が映っていないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨진 정보를 제거하고 저장합니다. 움직임은 가려지지 않으므로 사적인 내용이 보이지 않는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt bewaard zonder verborgen gegevens. De beweging wordt niet afgedekt, dus controleer of die niets privés laat zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowywane bez ukrytych danych. Ruch nie jest zamazywany, więc sprawdź, czy nie pokazuje niczego prywatnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É salvo sem os detalhes ocultos. O movimento não é ocultado, então verifique se ele não mostra nada privado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É guardado sem os detalhes ocultos. O movimento não é ocultado, por isso verifique se não mostra nada privado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas utan dolda uppgifter. Rörelsen maskeras inte, så kontrollera att den inte visar något privat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli ayrıntıları kaldırılarak kaydedilir. Hareket karartılmaz; özel bir şey göstermediğinden emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除隐藏信息后存储。动态画面不会被遮盖，请确认其中没有隐私内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除隱藏資訊後儲存。動態畫面不會被遮蓋，請確認其中沒有私人內容。"
          }
        }
      }
    },
