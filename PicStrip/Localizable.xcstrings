    "Useful to attackers in combination with other data. Email addresses, phone numbers, IP addresses, vehicle plates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفيدة للمهاجمين عند دمجها مع بيانات أخرى. عناوين البريد الإلكتروني، وأرقام الهواتف، وعناوين IP، ولوحات المركبات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Angreifer in Kombination mit anderen Daten nützlich. E-Mail-Adressen, Telefonnummern, IP-Adressen, Kfz-Kennzeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para un atacante en combinación con otros datos. Direcciones de correo electrónico, números de teléfono, direcciones IP y matrículas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para un atacante en combinación con otros datos. Direcciones de correo electrónico, números de teléfono, direcciones IP y placas de vehículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile à un attaquant en combinaison avec d’autres données. Adresses e-mail, numéros de téléphone, adresses IP, plaques d’immatriculation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile agli aggressori se combinato con altri dati. Indirizzi email, numeri di telefono, indirizzi IP, targhe dei veicoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のデータと組み合わせると攻撃者に利用される情報。メールアドレス、電話番号、IPアドレス、ナンバープレートなど。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 데이터와 결합하면 공격자에게 유용합니다. 이메일 주소, 전화번호, IP 주소, 차량 번호판."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuttig voor aanvallers in combinatie met andere gegevens. E-mailadressen, telefoonnummers, IP-adressen, kentekens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przydatne atakującym w połączeniu z innymi danymi. Adresy e-mail, numery telefonów, adresy IP, tablice rejestracyjne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil para invasores quando combinado com outros dados. Endereços de e-mail, números de telefone, endereços IP, placas de veículos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De utilidade para atacantes em combinação com outros dados. Endereços de e-mail, números de telefone, endereços IP e matrículas de veículos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användbart för angripare i kombination med andra uppgifter. E-postadresser, telefonnummer, IP-adresser, registreringsskyltar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer verilerle birleştiğinde saldırganların işine yarar. E-posta adresleri, telefon numaraları, IP adresleri, araç plakaları."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与其他数据结合后可被攻击者利用。电子邮件地址、电话号码、IP 地址、车牌号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與其他資料結合後，對攻擊者很有用。電子郵件地址、電話號碼、IP 位址、車牌。"
          }
        }
      }
    },
