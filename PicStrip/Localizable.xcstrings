    "Use Position & size to move or resize it." : {
      "comment" : "VoiceOver hint on the drawn box.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم ”الموضع والحجم“ لنقله أو تغيير حجمه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „Position & Größe“, um ihn zu bewegen oder seine Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa «Posición y tamaño» para moverlo o redimensionarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “Posición y tamaño” para moverlo o redimensionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Position et taille pour le déplacer ou le redimensionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Posizione e dimensioni per spostarlo o ridimensionarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「位置とサイズ」で移動やサイズ変更ができます。"
