    "Clean and save a photo to build an aggregate privacy summary.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia y guarda una foto para generar un resumen agregado de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyez et enregistrez une photo pour créer un résumé global de confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigen und speichern Sie ein Foto, um eine zusammenfassende Datenschutzübersicht zu erstellen."
