        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bipe substitui o som por um tom; silenciar remove o som."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett pip ersätter ljudet med en ton; tysta tar bort det."
          }
        },
        "tr" : {
          "stringUnit" : {
