          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報、カメラ、編集履歴など、画像の個人的なメタデータを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
