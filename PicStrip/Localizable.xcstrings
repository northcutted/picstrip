    "Credentials in screenshots or whiteboards can be reused directly if they are visible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Credentials in screenshots or whiteboards can be reused directly if they are visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales en capturas de pantalla o pizarras pueden reutilizarse directamente si son visibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants dans les captures d’écran ou sur les tableaux blancs peuvent être réutilisés directement s’ils sont visibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten in Screenshots oder Whiteboards können direkt wiederverwendet werden, wenn sie sichtbar sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットやホワイトボードにある認証情報は、表示されていれば直接再利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果凭证在截图或白板中可见,则可以直接重用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais em capturas de tela ou quadros brancos podem ser reutilizadas diretamente se estiverem visíveis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷이나 화이트보드에 있는 자격 증명은 보이는 경우 바로 재사용할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le credenziali negli screenshot o sulle lavagne possono essere riutilizzate direttamente se sono visibili."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenties in screenshots of whiteboards kunnen direct worden hergebruikt als ze zichtbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane uwierzytelniające na zrzutach ekranu lub tablicach można bezpośrednio ponownie wykorzystać, jeśli są widoczne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenser i skärmdumpar eller whiteboards kan återanvändas direkt om de är synliga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntülerinde veya beyaz tahtalarda bulunan kimlik bilgileri görünür durumdaysa doğrudan tekrar kullanılabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إعادة استخدام بيانات الاعتماد الموجودة في لقطات الشاشة أو الألواح البيضاء مباشرة إذا كانت مرئية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖或白板中的憑證如果可見,可以直接重複使用。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais em capturas de ecrã ou quadros brancos podem ser reutilizadas diretamente se estiverem visíveis."
          }
        }
      }
    },
