        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘위치 및 크기’를 사용하여 이동하거나 크기를 조절할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Positie en grootte om het te verplaatsen of het formaat aan te passen."
