    "Your photos are never uploaded to any server. All scanning, redaction, and metadata stripping happens entirely on your iPhone or iPad." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُرفع صورك أبدًا إلى أي خادم. تتم جميع عمليات الفحص والحجب وإزالة البيانات الوصفية بالكامل على iPhone أو iPad الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos werden niemals auf einen Server hochgeladen. Das gesamte Scannen, Schwärzen und Entfernen von Metadaten erfolgt ausschließlich auf deinem iPhone oder iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos nunca se suben a ningún servidor. Todo el análisis, la censura y la eliminación de metadatos se realizan íntegramente en tu iPhone o iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos ne sont jamais envoyées sur un serveur. L’analyse, le masquage et la suppression des métadonnées se font entièrement sur votre iPhone ou votre iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue foto non vengono mai caricate su nessun server. La scansione, l’oscuramento e la rimozione dei metadati avvengono interamente sul tuo iPhone o iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
