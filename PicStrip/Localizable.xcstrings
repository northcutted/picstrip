    "Hardware addresses can identify a specific device on a local network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لعناوين الأجهزة تحديد جهاز معين على شبكة محلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardware-Adressen können ein bestimmtes Gerät im lokalen Netzwerk identifizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hardware addresses can identify a specific device on a local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones de hardware pueden identificar un dispositivo específico en una red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adresses matérielles peuvent identifier un appareil spécifique sur un réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indirizzi hardware possono identificare un dispositivo specifico in una rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアアドレスは、ローカルネットワーク上の特定のデバイスを識別できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 주소는 로컬 네트워크 내 특정 장치를 식별할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardware-adressen kunnen een specifiek apparaat op een lokaal netwerk identificeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresy sprzętowe mogą identyfikować konkretne urządzenie w sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os endereços de hardware podem identificar um dispositivo específico numa rede local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os endereços de hardware podem identificar um dispositivo específico numa rede local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hårdvaruadresser kan identifiera en specifik enhet i ett lokalt nätverk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donanım adresleri, yerel ağdaki belirli bir cihazı tanımlayabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硬件地址可以在本地网络中识别特定设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硬體位址可識別本地網路上的特定裝置。"
          }
        }
      }
