    "Scans visible text and faces on device and burns redaction boxes over likely sensitive data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفحص النصوص والوجوه الظاهرة على الجهاز ويضع مربعات حجب دائمة فوق البيانات التي يُحتمل أنها حساسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannt sichtbaren Text und Gesichter auf dem Gerät und brennt Schwärzungen über wahrscheinlich sensible Daten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza en el dispositivo el texto y las caras visibles y graba recuadros de censura sobre los datos probablemente sensibles."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza en el dispositivo el texto y las caras visibles y graba recuadros de censura sobre los datos probablemente sensibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse sur l’appareil le texte et les visages visibles, puis incruste des masques sur les données probablement sensibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizza sul dispositivo testo e volti visibili e imprime riquadri di oscuramento sui dati probabilmente sensibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示されているテキストと顔をデバイス上でスキャンし、機密の可能性が高いデータをマスクで覆います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보이는 텍스트와 얼굴을 기기에서 검사하고 민감할 가능성이 있는 데이터 위에 가림 상자를 덧씌웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scant zichtbare tekst en gezichten op het apparaat en brandt afdekvakken over vermoedelijk gevoelige gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanuje na urządzeniu widoczny tekst i twarze oraz trwale zamazuje prawdopodobnie wrażliwe dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa no dispositivo o texto e os rostos visíveis e grava caixas de ocultação sobre dados provavelmente sensíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa no dispositivo o texto e os rostos visíveis e grava caixas de ocultação sobre dados provavelmente sensíveis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker igenom synlig text och ansikten på enheten och bränner in maskeringsrutor över uppgifter som troligen är känsliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünür metinleri ve yüzleri cihazda tarar, hassas olması muhtemel verilerin üzerine kalıcı karartma kutuları işler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设备端扫描可见文字和人脸，并在可能敏感的数据上叠加遮盖框。"
