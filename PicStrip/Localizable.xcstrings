          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip zbudowano na jednej zasadzie: prywatności. Aplikacja pomaga unikać udostępniania rzeczy, których nie zamierzasz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PicStrip byggdes på en enda princip: Sekretess. Appen finns för att hjälpa dig att undvika att dela saker du inte avser."
          }
        },
        "tr": {
