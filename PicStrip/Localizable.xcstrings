    "Metadata removal is permanent. The saved image will lose Live Photo motion data, GPS location, camera model, and editing history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة البيانات التعريفية دائمة. ستفقد الصورة المحفوظة بيانات حركة Live Photo، وموقع GPS، وطراز الكاميرا، وتاريخ التعديلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entfernen der Metadaten ist dauerhaft. Das gespeicherte Bild verliert Live Photo-Bewegungsdaten, GPS-Standort, Kameramodell und Bearbeitungshistorie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación de metadatos es permanente. La imagen guardada perderá datos de movimiento Live Photo, ubicación GPS, modelo de cámara e historial de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione dei metadati è permanente. L'immagine salvata perderà i dati di movimento della Live Photo, la posizione GPS, il modello della fotocamera e la cronologia delle modifiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione dei metadati è permanente. L'immagine salvata perderà i dati di movimento della Live Photo, la posizione GPS, il modello della fotocamera e la cronologia delle modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メタデータの削除は永久的です。保存された画像は、Live Photoの動きのデータ、GPSの位置情報、カメラモデル、編集履歴を失います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메타데이터 제거는 영구적입니다. 저장된 이미지에서는 라이브 포토 모션 데이터, GPS 위치, 카메라 모델 및 편집 기록이 손실됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verwijderen van metadata is definitief. De opgeslagen afbeelding verliest Live Photo bewegingsgegevens, GPS-locatie, cameramodel en bewerkgeschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie metadanych jest trwałe. Zapisany obraz straci dane ruchu Live Photo, lokalizację GPS, model aparatu i historię edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remoção de metadados é permanente. A imagem salva perderá os dados de movimento do Live Photo, localização GPS, modelo da câmera e histórico de edição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remoção dos metadados é permanente. A imagem guardada perderá dados de movimento do Live Photo, localização por GPS, modelo da câmara e histórico de edição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borttagning av metadata är permanent. Den sparade bilden förlorar Live Photo-rörelsedata, GPS-plats, kameramodell och redigeringshistorik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta verilerin kaldırılması kalıcıdır. Kaydedilen görsel, Live Photo hareket verilerini, GPS konumunu, kamera modelini ve düzenleme geçmişini kaybeder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元数据的移除是永久性的。保存的图像将失去Live Photo运动数据、GPS位置、相机型号和编辑历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除元数据是永久性的。保存的图片将失去实况照片运动数据、GPS 位置、相机型号和编辑历史。"
          }
        }
      }
    },
