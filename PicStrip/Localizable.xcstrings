    "Private Apple metadata: face detection data, HDR analysis, scene classification, front/rear camera ID": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos privados de Apple: datos de detección facial, análisis HDR, clasificación de escenas, identificación de cámara frontal/trasera"
          }
        },
        "fr": {
          "stringUnit": {
