    "Photos access is needed to save cleaned images. Grant access in Settings > Privacy > Photos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم الوصول إلى الصور لحفظ الصور النظيفة. امنح الإذن من الإعدادات > الخصوصية > الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Sichern bereinigter Bilder ist Zugriff auf Fotos erforderlich. Erlaube den Zugriff unter Einstellungen > Datenschutz > Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Fotos para guardar las imágenes limpias. Concédelo en Ajustes > Privacidad > Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à Photos est nécessaire pour enregistrer les images nettoyées. Autorisez-le dans Réglages > Confidentialité > Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per salvare le immagini pulite serve l’accesso a Foto. Consentilo in Impostazioni > Privacy > Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップした画像を保存するには「写真」へのアクセスが必要です。「設定」>「プライバシー」>「写真」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리된 이미지를 저장하려면 사진 접근 권한이 필요합니다. 설정 > 개인정보 보호 > 사진에서 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot Foto’s is nodig om opgeschoonde afbeeldingen te bewaren. Geef toegang via Instellingen > Privacy > Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do zachowywania wyczyszczonych obrazów potrzebny jest dostęp do Zdjęć. Włącz go w Ustawieniach > Prywatność > Zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário acesso ao app Fotos para salvar as imagens limpas. Conceda o acesso em Ajustes > Privacidade > Fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário acesso às Fotografias para guardar as imagens limpas. Conceda o acesso em Definições > Privacidade > Fotografias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till Bilder krävs för att spara rensade bilder. Tillåt åtkomst i Inställningar > Integritet > Bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temizlenen görüntüleri kaydetmek için Fotoğraflar erişimi gerekir. Ayarlar > Gizlilik > Fotoğraflar bölümünden izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“照片”访问权限才能存储清理后的图像。请在“设置”>“隐私”>“照片”中授予权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「照片」取用權限才能儲存清理後的影像。請在「設定」>「隱私權」>「照片」中授予權限。"
          }
        }
      }
    },
