            "value": "Metadatos adicionales incrustados en esta imagen que pueden contener información privada o identificativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées supplémentaires intégrées à cette image pouvant contenir des informations privées ou d'identification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche in diesem Bild eingebettete Metadaten, die private oder identifizierende Informationen enthalten können."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像に埋め込まれている、プライベートまたは特定可能な情報を含む可能性のある追加のメタデータ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图像中嵌入的可能包含私人或识别信息的附加元数据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados adicionais incorporados nesta imagem que podem conter informações privadas ou identificadoras."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지에 삽입된 추가 메타데이터로, 개인 정보나 식별 가능한 정보가 포함되어 있을 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadati aggiuntivi incorporati in questa immagine che possono contenere informazioni private o identificative."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanvullende metadata die in deze afbeelding zijn ingebed en mogelijk privé- of identificerende informatie bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowe metadane osadzone w tym obrazie, które mogą zawierać prywatne lub identyfikujące informacje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ytterligare metadata inbäddade i denna bild som kan innehålla privata eller identifierande uppgifter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu resme gömülü, özel veya kimlik belirleyici bilgiler içerebilecek ek meta veriler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات وصفية إضافية مضمنة في هذه الصورة قد تحتوي على معلومات خاصة أو تعريفية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影像中嵌入的額外元資料可能包含私密或識別性資訊。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados adicionais incorporados nesta imagem que podem conter informações privadas ou identificáveis."
          }
        }
      }
    },
