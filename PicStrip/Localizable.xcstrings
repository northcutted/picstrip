        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera si sta scaldando. La registrazione potrebbe scendere a 30 fps finché non si raffredda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの温度が上がっています。温度が下がるまで、録画が30fpsに下がる場合があります。"
