    "Camera access was denied. Please enable it in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الوصول إلى الكاميرا. يرجى تمكينه في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Kamera wurde verweigert. Aktiviere ihn bitte in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha denegado el acceso a la cámara. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à l’appareil photo a été refusé. Veuillez l’activer dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla fotocamera è stato negato. Attivalo nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスが拒否されました。「設定」で有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 거부되었습니다. 설정에서 허용해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot de camera is geweigerd. Schakel dit in bij Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do aparatu. Włącz go w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera foi negado. Ative-o em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmara foi recusado. Ative-o nas Definições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till kameran nekades. Tillåt åtkomst i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi reddedildi. Lütfen Ayarlar’dan etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机访问被拒绝。请在“设置”中启用访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機的取用權限已被拒絕。請在「設定」中開啟。"
          }
        }
      }
    },
    "Camera settings, the exact date and time the photo was taken, and your device model. The timestamp can expose your daily routine; the device model identifies your phone or camera." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعدادات الكاميرا، والتاريخ والوقت الدقيقان لالتقاط الصورة، وطراز جهازك. يمكن للطابع الزمني أن يكشف روتينك اليومي؛ وطراز الجهاز يحدد هاتفك أو الكاميرا الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraeinstellungen, das genaue Datum und die genaue Uhrzeit der Aufnahme sowie dein Gerätemodell. Der Zeitstempel kann deinen Tagesablauf offenlegen; das Gerätemodell identifiziert dein Telefon oder deine Kamera."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Camera settings, the exact date and time the photo was taken, and your device model. The timestamp can expose your daily routine; the device model identifies your phone or camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuración de la cámara, fecha y hora exacta de la foto, y modelo de tu dispositivo. La marca temporal puede revelar tu rutina diaria; el modelo identifica tu teléfono o cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages de l’appareil photo, date et heure exactes de la prise de vue, et modèle de votre appareil. L’horodatage peut révéler vos habitudes quotidiennes ; le modèle identifie votre téléphone ou votre appareil photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni della fotocamera, la data e l’ora esatte in cui la foto è stata scattata, e il modello del dispositivo. Il timestamp può rivelare la tua routine quotidiana; il modello identifica il tuo telefono o fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ設定、写真が撮影された正確な日時、およびデバイスのモデル。タイムスタンプは毎日の行動パターンを明らかにし、デバイスのモデルは使用中のスマートフォンやカメラを特定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 설정, 사진이 찍힌 정확한 날짜와 시간, 그리고 기기 모델입니다. 타임스탬프는 일상 생활 패턴을 노출할 수 있으며, 기기 모델은 사용자의 전화기나 카메라를 식별합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera-instellingen, de exacte datum en tijd waarop de foto is gemaakt, en je apparaatmodel. De tijdstempel kan je dagelijkse routine blootleggen; het apparaatmodel identificeert je telefoon of camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia aparatu, dokładna data i godzina wykonania zdjęcia oraz model urządzenia. Znacznik czasu może ujawnić Twój codzienny rytm; model urządzenia identyfikuje Twój telefon lub aparat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurações da câmera, a data e hora exatas em que a foto foi tirada e o modelo do seu dispositivo. O carimbo de data/hora pode expor sua rotina diária; o modelo do dispositivo identifica seu telefone ou câmera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definições da câmara, a data e a hora exatas em que a fotografia foi tirada e o modelo do seu dispositivo. A data e a hora podem revelar a sua rotina diária; o modelo do dispositivo identifica o seu telemóvel ou câmara."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerainställningar, det exakta datumet och tiden då bilden togs samt din enhetsmodell. Tidsstämpeln kan avslöja din dagliga rutin; enhetsmodellen identifierar din telefon eller kamera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera ayarları, fotoğrafın çekildiği tam tarih ve saat ile cihaz modeliniz. Zaman damgası günlük rutininizi ortaya çıkarabilir; cihaz modeli telefonunuzu veya kameranızı tanımlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机设置、照片拍摄的确切日期和时间，以及你的设备型号。时间戳可能暴露你的日常作息；设备型号会暴露你使用的手机或相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機設定、拍攝照片的確切日期與時間，以及你的裝置型號。時間戳記可能洩露你的日常作息，裝置型號則會辨識出你的手機或相機。"
          }
        }
      }
    },
