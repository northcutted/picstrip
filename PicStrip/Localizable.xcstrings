    "The video could not be recorded. Check that there is enough storage, then try again." : {
      "comment" : "Alert message under “Couldn’t Record”.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تسجيل الفيديو. تحقق من توفر مساحة تخزين كافية، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video konnte nicht aufgenommen werden. Prüfe, ob genügend Speicherplatz frei ist, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido grabar el vídeo. Comprueba que haya suficiente espacio de almacenamiento y vuelve a intentarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo grabar el video. Comprueba que haya suficiente espacio de almacenamiento e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo n’a pas pu être enregistrée. Vérifiez qu’il reste suffisamment d’espace de stockage, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile registrare il video. Verifica che ci sia spazio di archiviazione sufficiente, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを録画できませんでした。ストレージの空き容量が十分にあることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 녹화할 수 없습니다. 저장 공간이 충분한지 확인한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De video kan niet worden opgenomen. Controleer of er genoeg opslagruimte is en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można nagrać wideo. Sprawdź, czy jest wystarczająco dużo miejsca, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível gravar o vídeo. Verifique se há espaço de armazenamento suficiente e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível gravar o vídeo. Verifique se tem espaço de armazenamento suficiente e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att spela in videon. Kontrollera att det finns tillräckligt med lagringsutrymme och försök sedan igen."
