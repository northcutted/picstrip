        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass PicStrip geöffnet. Der Bildschirm bleibt eingeschaltet, bis die Stapelverarbeitung abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
