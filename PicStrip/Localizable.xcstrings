          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection par toucher utilise un modèle Apple téléchargé avec votre accord. Il analyse votre photo sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La selezione con un tocco usa un modello Apple scaricato con il tuo consenso. Il modello analizza la foto su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップによる選択には、許可を得てダウンロードするAppleのモデルを使います。写真の解析はこの端末上で行われます。"
